<?xml version="1.0" encoding="utf-8"?>
<!--
  빛 수집 노트에서 이미 받은 자리.

  우표처럼 점선 테두리를 두르되, 받은 것은 안쪽에 옅은 황금빛을 깔아
  못 받은 자리와 한눈에 갈리게 합니다.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/golden_100" />
    <corners android:radius="10dp" />
    <stroke
        android:width="1.5dp"
        android:color="@color/golden_300"
        android:dashWidth="4dp"
        android:dashGap="3dp" />
</shape>
