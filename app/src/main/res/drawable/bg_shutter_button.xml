<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 바깥 링 -->
    <item>
        <shape android:shape="oval">
            <stroke
                android:width="4dp"
                android:color="#FFFFFFFF" />
            <solid android:color="#33FFFFFF" />
        </shape>
    </item>
    <!-- 안쪽 원 -->
    <item
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp">
        <shape android:shape="oval">
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
</layer-list>
