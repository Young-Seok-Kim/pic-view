<?xml version="1.0" encoding="utf-8"?>
<!--
    정읍 시선 — 색 토큰

    시안(Figma)의 '단풍(maple)' 팔레트 기준.
    주색 #B23A1B, 배경은 흰색이 아니라 크림(#FDF6EF) 계열입니다.

    ▸ 팔레트(maple_*, moss_*, sand_*)는 직접 쓰지 말고
      아래 시맨틱 토큰(bg_*, text_*, chip_* …)을 통해 쓰세요.
      values-night 에서 시맨틱만 재정의하면 다크 모드가 따라옵니다.
-->
<resources>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <!-- ============ 팔레트 : 단풍(주색) ============ -->
    <color name="maple_50">#FBEEE9</color>
    <color name="maple_100">#F5D5C8</color>
    <color name="maple_200">#E8AC93</color>
    <color name="maple_300">#D9805E</color>
    <color name="maple_400">#C75B36</color>
    <color name="maple_500">#B23A1B</color>
    <color name="maple_600">#9A3016</color>
    <color name="maple_700">#7D2611</color>
    <color name="maple_800">#5C1B0C</color>
    <color name="maple_900">#3B1108</color>

    <!-- ============ 팔레트 : 이끼(보조 / 시니어 오디오) ============ -->
    <color name="moss_50">#EEF1E8</color>
    <color name="moss_100">#D6DEC7</color>
    <color name="moss_300">#9CAE7C</color>
    <color name="moss_500">#6B7F4B</color>
    <color name="moss_600">#586A3D</color>
    <color name="moss_700">#43512E</color>

    <!-- ============ 팔레트 : 황금(골든아워 / 포토스코어) ============ -->
    <color name="golden_100">#FDF0D5</color>
    <color name="golden_200">#F9DFA8</color>
    <color name="golden_300">#F2C86B</color>
    <color name="golden_500">#E0A32E</color>
    <color name="golden_600">#C08420</color>
    <color name="golden_700">#946117</color>

    <!-- ============ 팔레트 : 모래(뉴트럴, 웜톤) ============ -->
    <color name="sand_950">#1A1512</color>
    <color name="sand_900">#2A211C</color>
    <color name="sand_800">#3D3128</color>
    <color name="sand_700">#5A4A3E</color>
    <color name="sand_600">#7A675A</color>
    <color name="sand_500">#9B8878</color>
    <color name="sand_400">#BBAA9B</color>
    <color name="sand_300">#D6C9BC</color>
    <color name="sand_200">#E8DED4</color>
    <color name="sand_100">#F3ECE4</color>
    <color name="sand_50">#FBF6F1</color>

    <!-- ============ 외부 브랜드 ============ -->
    <color name="naver_green">#03C75A</color>
    <color name="kakao_yellow">#FEE500</color>

    <!-- ============ 시맨틱(라이트) : values-night 에서 재정의됨 ============ -->
    <color name="bg_page">#FDF6EF</color>
    <color name="bg_card">#FFFFFF</color>
    <color name="bg_card_muted">#F6EEE6</color>
    <color name="bg_image_placeholder">#EBE0D6</color>
    <color name="bg_bottom_nav">#FFFDFB</color>

    <color name="text_primary">#2A211C</color>
    <color name="text_secondary">#5A4A3E</color>
    <color name="text_tertiary">#9B8878</color>
    <color name="text_on_brand">#FFFFFF</color>

    <color name="divider">#EDE2D8</color>
    <color name="card_stroke">#F0E6DC</color>
    <!-- LIGHT MATCH 시안의 파란 눈썹. 붉은 본문 팔레트 속에서
         "여기는 다른 종류의 정보"라고 말하는 색입니다. -->
    <color name="eyebrow_blue">#3B5BDB</color>

    <color name="chip_bg">#FFFFFF</color>
    <color name="chip_bg_selected">#B23A1B</color>
    <color name="chip_stroke">#E8DED4</color>
    <color name="chip_icon">#7A675A</color>
    <color name="chip_icon_selected">#FFFFFF</color>
    <color name="chip_text">#5A4A3E</color>
    <color name="chip_text_selected">#FFFFFF</color>

    <color name="score_chip_bg">#FDF0D5</color>
    <color name="score_chip_icon">#C08420</color>
    <color name="score_chip_text">#946117</color>

    <color name="btn_secondary_bg">#FBEEE9</color>
    <color name="btn_secondary_text">#9A3016</color>

    <color name="score_badge_bg">#E62A211C</color>
    <color name="scrim_strong">#99000000</color>
    <color name="scrim_soft">#40000000</color>

    <!--
        사진 위에 얹히는 버튼.

        브랜드색을 그대로 쓰면 사진 위에서 혼자 형광처럼 튀고, 뒤에 있는
        장면을 이깁니다. 어두운 반투명은 어떤 사진 위에서도 가라앉으면서
        흰 글씨의 대비는 지킵니다.
    -->
    <color name="btn_on_photo">#CC1A1512</color>

    <!-- ============ 빛 스케줄(출사 코스) 전용 ============ -->
    <!-- 코스 타임라인에서 시간대를 색으로 구분합니다. -->
    <color name="light_sunrise">#E8834A</color>
    <color name="light_morning">#E0A32E</color>
    <color name="light_midday">#9B8878</color>
    <color name="light_sunset">#B23A1B</color>
    <color name="light_night">#2B3552</color>
    <!--
      블루아워 두 종.
      전에는 새벽·저녁·야간이 light_night 한 색을 함께 썼습니다. 그러면
      빛 흐름 그림에서 하루의 시작과 끝과 한밤이 전부 같은 파랑이라
      구간이 나뉜 것을 눈으로 확인할 수 없습니다.
      새벽은 밝아지는 쪽이라 옅게, 저녁은 어두워지는 쪽이라 짙게 둡니다.
    -->
    <color name="light_blue_dawn">#5C7CA8</color>
    <color name="light_blue_dusk">#414E7D</color>
    <!-- 오후는 오전과 같은 노랑을 쓰면 한낮을 사이에 두고 좌우가 같아 보입니다. -->
    <color name="light_afternoon">#D08A3C</color>

    <!--
      히어로 카드 바탕 — 지금의 빛 구간을 따라갑니다.

      단풍 빨강 하나로 고정돼 있었습니다. 그러면 카드가 "야간"이라고 말하는
      동안에도 화면은 대낮처럼 붉어서, 글자와 색이 서로 다른 말을 합니다.
      이 앱은 빛을 다루므로 이 카드의 색 자체가 정보여야 합니다.

      호에 쓰는 구간 색을 그대로 쓸 수는 없습니다. 노랑·회색 위에 흰 글씨를
      얹으면 안 읽힙니다. 같은 계열에서 명도만 낮춘 짝을 따로 둡니다.
    -->
    <color name="hero_blue_dawn">#3A4A6B</color>
    <color name="hero_sunrise">#C25A2E</color>
    <color name="hero_morning">#A97516</color>
    <color name="hero_midday">#6E6152</color>
    <color name="hero_afternoon">#A96322</color>
    <color name="hero_sunset">#A6321A</color>
    <color name="hero_blue_dusk">#333F63</color>
    <color name="hero_night">#232C45</color>

    <!--
      히어로 카드에서 구간 이름만 띄우는 색.
      단풍 배경 위라 흰색보다 밝게는 못 가고, 노란 기가 도는 크림이라야
      붉은 바탕에서 뜹니다.
    -->
    <color name="hero_accent">#FFD9A0</color>

    <!-- ============ 빛 흐름 풍경 ============ -->
    <!--
      호 아래에 정읍의 지형을 깔아 둡니다. 왼쪽은 해가 뜨는 붉은 흙,
      가운데는 들과 나무, 오른쪽은 해가 지는 쪽의 푸른 산과 물입니다.
      왼쪽에서 오른쪽으로 갈수록 따뜻한 색에서 찬 색으로 넘어가게 두면
      호의 색 흐름(일출 주황 → 야간 남색)과 땅이 같은 방향을 가리킵니다.
    -->
    <color name="scene_cloud">#F4EDE2</color>
    <color name="scene_sand">#E7DCCB</color>
    <color name="scene_coral">#D98C6E</color>
    <color name="scene_coral_deep">#C4674A</color>
    <color name="scene_khaki">#C9C1A0</color>
    <color name="scene_olive">#A9A87F</color>
    <color name="scene_slate">#8496AC</color>
    <color name="scene_water">#4E657E</color>
    <color name="scene_tree">#7C9070</color>

    <!-- 상세의 "이 장소만의 한 줄". 옆의 흰 상자와 달리 노란 기를 둡니다. -->
    <color name="detail_note_bg">#FFF4E2C4</color>

    <!--
      상세의 라이브 날씨 카드.
      아래 빛 카드가 밝은 살구색이라 같은 톤으로 두면 두 카드가 한 덩어리로
      뭉쳐 보입니다. 어둡게 둬야 "지금 바깥 상태"라는 다른 성격이 읽힙니다.
    -->
    <color name="live_weather_bg">#FF2A2328</color>
    <color name="live_weather_eyebrow">#FFD9A87C</color>

    <!-- ============ 색감 필터 ============ -->
    <!-- 사진 위에 얹히는 화면이라 배경을 어둡게 둬야 색이 제대로 보입니다. -->
    <color name="palette_bg">#141014</color>
    <color name="palette_card_bg">#241E24</color>

    <!-- ============ 미션 유형 ============ -->
    <!--
      유형마다 색을 나눕니다. 미션이 여섯 개일 때는 목록이 그냥 목록이지만
      스물 몇 개가 되면 "무엇을 해볼까"를 고르는 화면이 됩니다. 그때 색이
      갈래를 먼저 알려 줍니다.

      진한 색은 아이콘·진행 막대에, 옅은 색은 아이콘 원 바탕에 씁니다.
      미완료는 옅은 바탕이라 목록 전체가 조용하고, 완료한 것만 진해집니다.
    -->
    <color name="mission_light">#D9A32E</color>
    <color name="mission_light_soft">#FBEFD2</color>
    <color name="mission_weather">#6E8AA6</color>
    <color name="mission_weather_soft">#E3EBF2</color>
    <color name="mission_season">#D0708F</color>
    <color name="mission_season_soft">#F8E4EA</color>
    <color name="mission_place">#6F9070</color>
    <color name="mission_place_soft">#E4EFE2</color>
    <color name="mission_compare">#9A6B4A</color>
    <color name="mission_compare_soft">#F1E5DA</color>
    <color name="mission_record">#8B7CB0</color>
    <color name="mission_record_soft">#EBE6F5</color>
    <color name="mission_share">#D98963</color>
    <color name="mission_share_soft">#FAE6DC</color>

    <!-- ============ 계절 ============ -->
    <!--
      계절 칩을 고르면 그 계절의 색이 켜집니다. 넷 다 앱 대표색(단풍 빨강)
      이면 무엇을 골랐는지 색으로는 알 수 없고, 겨울을 골랐는데 화면이
      단풍색이 되는 어긋남도 생깁니다.

      정읍에서 실제로 찍히는 것에서 색을 가져왔습니다.
      봄은 벚꽃·진달래의 분홍, 여름은 내장산 신록의 초록,
      가을은 은행잎의 노란 기가 도는 주황, 겨울은 얼음의 시린 파랑입니다.
    -->
    <color name="season_spring">#D96A93</color>
    <color name="season_summer">#3F8F5C</color>
    <color name="season_autumn">#D9822B</color>
    <color name="season_winter">#5B93B8</color>

    <!--
        ============ 촬영 목적(탐색 지도) ============
        지도 마커·범례·칩이 같은 색을 씁니다. 다섯 목적이 전부 단풍색이면
        지도에서 무엇이 어디 있는지 색으로 읽을 수 없습니다.
    -->
    <color name="purpose_reflect">#FFC08420</color>
    <color name="purpose_silhouette">#FFC75B36</color>
    <color name="purpose_person">#FF8B7CB0</color>
    <color name="purpose_arch">#FF2F6DB5</color>
    <color name="purpose_space">#FF7A675A</color>

    <!--
        ============ 날씨 여섯 (시선 가이드 탭) ============
        여섯 탭이 전부 같은 색이면 무엇을 고른 상태인지 글자를 읽어야
        압니다. 날씨의 실제 톤을 그대로 씁니다 — 일출은 주황, 비는 블루.
        container 는 선택된 탭의 배경(밝은 화면 위)입니다.
    -->
    <color name="weather_clear">#FFD98E1A</color>
    <color name="weather_clear_container">#FFFCEFD5</color>
    <color name="weather_cloudy">#FF6E7B85</color>
    <color name="weather_cloudy_container">#FFEDF0F2</color>
    <color name="weather_sunrise">#FFE0662B</color>
    <color name="weather_sunrise_container">#FFFCE7DA</color>
    <color name="weather_sunset">#FFC1462F</color>
    <color name="weather_sunset_container">#FFFAE0DA</color>
    <color name="weather_night">#FF3E4A78</color>
    <color name="weather_night_container">#FFE4E7F2</color>
    <color name="weather_rain">#FF2F6DB5</color>
    <color name="weather_rain_container">#FFE2ECF7</color>

    <!--
        ============ 스토리(달·사랑·혁명·느림·계절) ============
        촬영 목적이 "무엇을 찍는가"의 색이라면, 이것은 "어떤 이야기를
        걷는가"의 색입니다. 스토리 칩을 고른 순간에만 지도가 이 색으로
        바뀌므로 목적 색과 겹쳐 보이지 않습니다.
        달=달빛 네이비, 사랑=연분홍, 혁명=적갈, 느림=흙빛 세피아, 계절=상록.
    -->
    <color name="story_moon">#FF3E4A78</color>
    <color name="story_love">#FFC2607F</color>
    <color name="story_revolution">#FF8E3B2A</color>
    <color name="story_slow">#FF8A6E4B</color>
    <color name="story_season">#FF3F7D4E</color>

    <!-- 하단 탭 -->
    <color name="nav_item_active">#B23A1B</color>
    <color name="nav_item_inactive">#9B8878</color>
    <!-- ============ 촬영 화면 포즈 카드 (어두운 배경 위) ============ -->
    <color name="pose_card_bg">#D91A1512</color>
    <color name="pose_card_stroke">#33FFFFFF</color>
    <color name="pose_card_text">#FFFFFFFF</color>
    <color name="pose_card_muted">#B3E8DED4</color>
    <color name="pose_card_bg_selected">#F2B23A1B</color>
    <color name="pose_card_stroke_selected">#FFE0A32E</color>
    <!--
        ============ 주제별 색 ============
        지도 마커·목록 카드·필터가 같은 색을 씁니다.
        container 는 밝은 배경 위 알약용(글자색은 진한 쪽).
    -->
    <color name="theme_nature">#FF3F7D4E</color>
    <color name="theme_nature_container">#FFE6F0E8</color>
    <color name="theme_culture">#FFB23A1B</color>
    <color name="theme_culture_container">#FFF7E4DE</color>
    <color name="theme_leports">#FF2F6DB5</color>
    <color name="theme_leports_container">#FFE2ECF7</color>
    <color name="theme_food">#FFB07A0E</color>
    <color name="theme_food_container">#FFFAEED2</color>
    <color name="theme_etc">#FF7A6A5E</color>
    <color name="theme_etc_container">#FFEFEAE5</color>
    <!--
        ============ 빠른 이동 타일 ============
        시안(🏠 HomeScreen QA_0~3)에서 뽑은 색입니다.
        단풍 한 계열만 쓰던 화면에 올리브·오렌지·딥마룬을 더해
        타일이 서로 구분되게 합니다.
    -->
    <color name="qa_course">#FFB23A1B</color>
    <color name="qa_calendar">#FF6B7A3A</color>
    <color name="qa_diary">#FFE37A2C</color>
    <color name="qa_live">#FF7A1E10</color>
    <!-- 포토 프레임 화면 배경. 어두워야 폴라로이드 종이가 떠 보입니다. -->
    <color name="frame_bg">#FF3A1710</color>
    <!-- 빛 흐름 아치 아래 언덕. 지평선을 만들어 호의 시작·끝을 받쳐 줍니다. -->
    <!-- 호 아래를 옅게 채우는 색. 카드 배경보다 한 톤만 어두워야 합니다. -->
    <color name="sun_arc_fill">#FFF3EDE4</color>
</resources>
