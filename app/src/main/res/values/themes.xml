<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ================= 앱 기본 테마 (단풍) ================= -->
    <style name="Base.Theme.PicView" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary : 단풍 레드 -->
        <item name="colorPrimary">@color/maple_500</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/maple_50</item>
        <item name="colorOnPrimaryContainer">@color/maple_700</item>

        <!-- Secondary : 딥 단풍 -->
        <item name="colorSecondary">@color/maple_600</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/maple_100</item>
        <item name="colorOnSecondaryContainer">@color/maple_800</item>

        <!-- Tertiary : 골든아워 -->
        <item name="colorTertiary">@color/golden_500</item>
        <item name="colorOnTertiary">@color/white</item>
        <item name="colorTertiaryContainer">@color/golden_100</item>
        <item name="colorOnTertiaryContainer">@color/golden_700</item>

        <!-- Surface -->
        <item name="android:colorBackground">@color/bg_page</item>
        <item name="colorSurface">@color/bg_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/bg_card_muted</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/divider</item>
        <item name="colorOutlineVariant">@color/card_stroke</item>

        <!-- 시스템 바 : 엣지 투 엣지 -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>

        <!--
            타이포그래피 : Pretendard (시안의 Inter 를 한글까지 덮는 대응 서체)
            fontFamily 만 지정하면 Material 컴포넌트는 각자의 textAppearance 에
            박힌 서체를 그대로 쓰므로, M3 타입스케일 15종을 모두 갈아끼웁니다.
        -->
        <item name="fontFamily">@font/pretendard</item>
        <item name="android:fontFamily">@font/pretendard</item>

        <item name="textAppearanceDisplayLarge">@style/TextAppearance.PicView.DisplayLarge</item>
        <item name="textAppearanceDisplayMedium">@style/TextAppearance.PicView.DisplayMedium</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.PicView.DisplaySmall</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.PicView.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.PicView.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.PicView.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.PicView.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.PicView.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.PicView.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.PicView.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.PicView.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.PicView.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.PicView.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.PicView.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.PicView.LabelSmall</item>

        <item name="materialAlertDialogTheme">@style/ThemeOverlay.PicView.Dialog</item>
    </style>

    <!-- ================= 다이얼로그 ================= -->
    <style name="ThemeOverlay.PicView.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="alertDialogStyle">@style/MaterialAlertDialog.PicView</item>
        <item name="materialAlertDialogTitleTextStyle">@style/MaterialAlertDialog.PicView.Title</item>
        <item name="materialAlertDialogBodyTextStyle">@style/MaterialAlertDialog.PicView.Body</item>
        <item name="buttonBarPositiveButtonStyle">@style/MaterialAlertDialog.PicView.PositiveButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/MaterialAlertDialog.PicView.NegativeButton</item>
        <item name="colorSurface">@color/bg_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
    </style>

    <style name="MaterialAlertDialog.PicView" parent="MaterialAlertDialog.Material3">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.PicView.Dialog</item>
        <item name="backgroundInsetStart">@dimen/space_2xl</item>
        <item name="backgroundInsetEnd">@dimen/space_2xl</item>
    </style>

    <style name="ShapeAppearance.PicView.Dialog" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_card</item>
    </style>

    <style name="MaterialAlertDialog.PicView.Title" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textStyle">bold</item>
        <item name="fontFamily">@font/pretendard</item>
        <item name="android:fontFamily">@font/pretendard</item>
    </style>

    <style name="MaterialAlertDialog.PicView.Body" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:lineSpacingExtra">4dp</item>
        <item name="fontFamily">@font/pretendard</item>
        <item name="android:fontFamily">@font/pretendard</item>
    </style>

    <style name="MaterialAlertDialog.PicView.PositiveButton" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/maple_500</item>
        <item name="android:textSize">@dimen/text_button</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">@dimen/touch_target</item>
    </style>

    <style name="MaterialAlertDialog.PicView.NegativeButton" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/text_tertiary</item>
        <item name="android:textSize">@dimen/text_button</item>
        <item name="android:minHeight">@dimen/touch_target</item>
    </style>

    <!-- ================= M3 타입스케일 : 서체만 교체 ================= -->
    <style name="TextAppearance.PicView.DisplayLarge" parent="TextAppearance.Material3.DisplayLarge">
        <item name="fontFamily">@font/pretendard</item>
        <item name="android:fontFamily">@font/pretendard</item>
    </style>
    <style name="TextAppearance.PicView.DisplayMedium" parent="TextAppearance.Material3.DisplayMedium">
        <item name="fontFamily">@font/pretendard</item>
        <item name="android:fontFamily">@font/pretendard</item>
    </style>
    <style name="TextAppearance.PicView.DisplaySmall" parent="TextAppearance.Material3.DisplaySmall">
        <item name="fontFamily">@font/pretendard</item>
        <item name="android:fontFamily">@font/pretendard</item>
    </style>
    <style name="TextAppearance.PicView.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="fontFamily">@font/pretendard</item>
        <item name="android:fontFamily">@font/pretendard</item>
    </style>
    <style name="TextAppearance.PicView.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="fontFamily">@font/pretendard</item>
        <item name="android:fontFamily">@font/pretendard</item>
    </style>
    <style name="TextAppearance.PicView.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="fontFamily">@font/pretendard</item>
        <item name="android:fontFamily">@font/pretendard</item>
    </style>
    <style name="TextAppearance.PicView.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">@font/pretendard</item>
        <item name="android:fontFamily">@font/pretendard</item>
    </style>
    <style name="TextAppearance.PicView.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">@font/pretendard</item>
        <item name="android:fontFamily">@font/pretendard</item>
    </style>
    <style name="TextAppearance.PicView.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="fontFamily">@font/pretendard</item>
        <item name="android:fontFamily">@font/pretendard</item>
    </style>
    <style name="TextAppearance.PicView.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="fontFamily">@font/pretendard</item>
        <item name="android:fontFamily">@font/pretendard</item>
    </style>
    <style name="TextAppearance.PicView.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/pretendard</item>
        <item name="android:fontFamily">@font/pretendard</item>
    </style>
    <style name="TextAppearance.PicView.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="fontFamily">@font/pretendard</item>
        <item name="android:fontFamily">@font/pretendard</item>
    </style>
    <style name="TextAppearance.PicView.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">@font/pretendard</item>
        <item name="android:fontFamily">@font/pretendard</item>
    </style>
    <style name="TextAppearance.PicView.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="fontFamily">@font/pretendard</item>
        <item name="android:fontFamily">@font/pretendard</item>
    </style>
    <style name="TextAppearance.PicView.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="fontFamily">@font/pretendard</item>
        <item name="android:fontFamily">@font/pretendard</item>
    </style>

    <style name="Theme.PicView" parent="Base.Theme.PicView" />

    <!--
        ================= 시니어 간편 모드 =================
        스펙 §17-2 기준. 색 대비를 AAA(7:1) 로 올리고 터치 타깃을 키웁니다.

        글씨 크기는 여기서 지정하지 않습니다.
        SeniorModeManager 가 Configuration.fontScale 로 앱 전체 sp 를
        한 번에 배율 조정하기 때문입니다(보통 1.0 / 크게 1.25 / 매우 크게 1.6).
        테마로 textSize 를 박으면 3단계 조절과 충돌합니다.
    -->
    <style name="Theme.PicView.Senior" parent="Theme.PicView">
        <!-- 대비 강화 : 한 톤 진한 주색 -->
        <item name="colorPrimary">@color/maple_600</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/maple_50</item>
        <item name="colorOnPrimaryContainer">@color/maple_800</item>

        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_primary</item>

        <item name="materialButtonStyle">@style/Button.Senior</item>
        <item name="materialCardViewStyle">@style/Card.Senior</item>
    </style>

    <!-- ================= 스플래시 ================= -->
    <style name="Theme.PicView.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/maple_600</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.PicView</item>
    </style>

    <!-- ================= 카메라(촬영 가이드) ================= -->
    <style name="Theme.PicView.Camera" parent="Theme.PicView">
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- ================= 텍스트 스타일 ================= -->
    <!--
        히어로 제목만 마포백패킹(마포구 공공서체, 공공누리 1유형).
        본문·라벨은 Pretendard 그대로 둡니다. 큰 글씨 모드에서 본문까지
        디스플레이 서체가 되면 가독성이 떨어지기 때문입니다.
    -->
    <style name="Text.Display" parent="TextAppearance.PicView.HeadlineMedium">
        <item name="fontFamily">@font/mapo_backpacking</item>
        <item name="android:fontFamily">@font/mapo_backpacking</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="Text.Title" parent="TextAppearance.PicView.TitleLarge">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.015</item>
    </style>

    <style name="Text.SectionTitle" parent="TextAppearance.PicView.TitleMedium">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_section</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="Text.Body" parent="TextAppearance.PicView.BodyMedium">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>

    <style name="Text.Caption" parent="TextAppearance.PicView.BodySmall">
        <item name="android:textColor">@color/text_tertiary</item>
        <item name="android:textSize">@dimen/text_caption</item>
    </style>

    <!--
        읽는 글 : 장소 개요처럼 문단으로 이어지는 본문.
        KoPubWorld 바탕(전자출판용 세리프)으로 UI 라벨과 시각적으로 구분합니다.
    -->
    <style name="Text.Reading" parent="TextAppearance.PicView.BodyLarge">
        <item name="fontFamily">@font/kopub_batang_light</item>
        <item name="android:fontFamily">@font/kopub_batang_light</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:lineSpacingExtra">7dp</item>
    </style>

    <!--
        일기 : 사용자가 다녀온 하루의 기록.
        손글씨체를 써서 '앱이 만든 정보'가 아니라 '내가 쓴 글'로 읽히게 합니다.
    -->
    <style name="Text.Diary" parent="TextAppearance.PicView.BodyLarge">
        <item name="fontFamily">@font/kyobo_handwriting</item>
        <item name="android:fontFamily">@font/kyobo_handwriting</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">17sp</item>
        <item name="android:lineSpacingExtra">8dp</item>
    </style>

    <style name="Text.Diary.Title" parent="Text.Diary">
        <item name="android:textColor">@color/maple_600</item>
        <item name="android:textSize">22sp</item>
    </style>

    <!-- 빛 스케줄 타임라인의 시각 표기 (05:42 …) -->
    <style name="Text.ClockTime" parent="TextAppearance.PicView.TitleMedium">
        <item name="android:textColor">@color/maple_500</item>
        <item name="android:textSize">@dimen/text_section</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <!-- ================= 컴포넌트 스타일 ================= -->
    <style name="Card.Elevated" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/bg_card</item>
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/card_stroke</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Card.Senior" parent="Card.Elevated">
        <item name="cardCornerRadius">@dimen/radius_card_senior</item>
        <item name="contentPadding">@dimen/space_senior</item>
    </style>

    <style name="Chip.Category" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_bg_selector</item>
        <item name="android:textColor">@color/chip_content_selector</item>
        <item name="chipStrokeColor">@color/chip_stroke_selector</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipIconVisible">true</item>
        <item name="chipIconTint">@color/chip_content_selector</item>
        <item name="chipIconSize">18dp</item>
        <item name="chipStartPadding">10dp</item>
        <item name="chipEndPadding">12dp</item>
        <item name="iconStartPadding">2dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipMinHeight">38dp</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textStyle">bold</item>
        <item name="rippleColor">#33B23A1B</item>
    </style>

    <!-- 스타일 태그(#사진 #자연 …) — 아이콘 없는 형태 -->
    <style name="Chip.Tag" parent="Chip.Category">
        <item name="chipIconVisible">false</item>
        <item name="chipMinHeight">36dp</item>
    </style>

    <style name="Button.Primary" parent="Widget.Material3.Button">
        <item name="android:textSize">@dimen/text_button</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">8dp</item>
        <item name="iconSize">20dp</item>
    </style>

    <!-- 시니어 : 높이 68dp 이상 (스펙 §17-2) -->
    <style name="Button.Senior" parent="Button.Primary">
        <item name="android:minHeight">@dimen/touch_target_senior</item>
        <item name="android:paddingTop">@dimen/space_l</item>
        <item name="android:paddingBottom">@dimen/space_l</item>
        <item name="cornerRadius">@dimen/radius_button_senior</item>
    </style>

    <!-- ================= 하단 탭 ================= -->
    <style name="BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/bg_bottom_nav</item>
        <item name="itemIconTint">@color/nav_item_selector</item>
        <item name="itemTextColor">@color/nav_item_selector</item>
        <item name="itemActiveIndicatorStyle">@style/BottomNav.Indicator</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="itemIconSize">24dp</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="BottomNav.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/maple_50</item>
        <item name="android:width">56dp</item>
        <item name="android:height">32dp</item>
    </style>

    <!--
        촬영 화면의 인원 칩. 카메라 미리보기 위에 얹히므로
        탐색 탭의 밝은 칩(Chip.Category)과 달리 어두운 배경을 씁니다.
    -->
    <style name="Chip.Pose" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/pose_chip_bg_selector</item>
        <item name="android:textColor">@color/pose_chip_text_selector</item>
        <item name="chipStrokeColor">@color/pose_chip_stroke_selector</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipIconVisible">false</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipMinHeight">34dp</item>
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
