<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.PicView" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary : 다크에서는 한 톤 밝게 -->
        <item name="colorPrimary">@color/brand_300</item>
        <item name="colorOnPrimary">@color/brand_900</item>
        <item name="colorPrimaryContainer">@color/brand_700</item>
        <item name="colorOnPrimaryContainer">@color/brand_100</item>

        <item name="colorSecondary">@color/brand_400</item>
        <item name="colorOnSecondary">@color/brand_900</item>
        <item name="colorSecondaryContainer">@color/brand_800</item>
        <item name="colorOnSecondaryContainer">@color/brand_100</item>

        <item name="colorTertiary">@color/golden_300</item>
        <item name="colorOnTertiary">@color/ink_950</item>
        <item name="colorTertiaryContainer">@color/golden_700</item>
        <item name="colorOnTertiaryContainer">@color/golden_100</item>

        <item name="android:colorBackground">@color/bg_page</item>
        <item name="colorSurface">@color/bg_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/bg_card_muted</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/divider</item>
        <item name="colorOutlineVariant">@color/card_stroke</item>

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>

</resources>
