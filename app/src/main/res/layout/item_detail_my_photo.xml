<?xml version="1.0" encoding="utf-8"?>
<!--
    상세 화면 "내가 찍은 사진" 띠의 한 칸.

    정사각형 섬네일만 둡니다. 장소 이름은 이 화면 전체가 그 장소라 필요
    없고, 날짜는 눌러서 크게 볼 때 보여 줍니다.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="96dp"
    android:layout_height="96dp"
    android:layout_marginEnd="@dimen/space_s"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <ImageView
        android:id="@+id/iv_my_shot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/cd_my_shot"
        android:scaleType="centerCrop"
        tools:src="@drawable/bg_image_placeholder" />
</com.google.android.material.card.MaterialCardView>
