<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page"
    android:clickable="true"
    android:focusable="true">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="104dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ================= 히어로 이미지 ================= -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="330dp"
                android:background="@color/bg_image_placeholder">

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/vp_detail_images"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- 사진이 없을 때 -->
                <LinearLayout
                    android:id="@+id/layout_no_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="gone">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="@null"
                        android:src="@drawable/baseline_image_24"
                        app:tint="@color/text_tertiary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_m"
                        android:text="@string/no_image"
                        android:textAppearance="@style/Text.Caption" />
                </LinearLayout>

                <!-- 상단 스크림 (뒤로가기 버튼 가독성) -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="96dp"
                    android:layout_gravity="top"
                    android:background="@drawable/bg_scrim_top" />

                <ImageView
                    android:id="@+id/btn_back"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="top|start"
                    android:layout_margin="@dimen/space_m"
                    android:background="@drawable/bg_glass_circle"
                    android:contentDescription="@string/cd_back"
                    android:padding="9dp"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/white" />

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/progressBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:indeterminate="true"
                    android:visibility="gone"
                    app:indicatorColor="@color/white" />

                <ImageView
                    android:id="@+id/iv_arrow_left"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="@dimen/space_m"
                    android:background="@drawable/bg_glass_circle"
                    android:contentDescription="@string/cd_prev_image"
                    android:padding="6dp"
                    android:src="@drawable/baseline_chevron_left_24"
                    android:visibility="gone"
                    app:tint="@color/white" />

                <ImageView
                    android:id="@+id/iv_arrow_right"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="@dimen/space_m"
                    android:background="@drawable/bg_glass_circle"
                    android:contentDescription="@string/cd_next_image"
                    android:padding="6dp"
                    android:src="@drawable/baseline_chevron_right_24"
                    android:visibility="gone"
                    app:tint="@color/white" />

                <!-- 페이지 인디케이터 -->
                <LinearLayout
                    android:id="@+id/layout_indicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="18dp"
                    android:gravity="center"
                    android:orientation="horizontal" />
            </FrameLayout>

            <!-- ================= 본문 ================= -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/bg_page"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingTop="24dp">

                <!-- 포토스코어 배지 -->
                <LinearLayout
                    android:id="@+id/layout_detail_score"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_m"
                    android:background="@drawable/bg_score_chip"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="11dp"
                    android:paddingVertical="6dp"
                    tools:visibility="visible">

                    <ImageView
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_star"
                        app:tint="@color/score_chip_icon" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:text="@string/detail_photo_score"
                        android:textColor="@color/score_chip_text"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tv_detail_score"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:textColor="@color/score_chip_text"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="92" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_detail_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:letterSpacing="-0.02"
                    android:textColor="@color/text_primary"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    tools:text="내장산 국립공원" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginTop="2dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_place"
                        app:tint="@color/text_tertiary" />

                    <TextView
                        android:id="@+id/tv_detail_address"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:textColor="@color/text_secondary"
                        android:textSize="15sp"
                        tools:text="전북특별자치도 정읍시 내장산로 936" />
                </LinearLayout>

                <!-- ============ 촬영 정보 (방위 · 최적 시간 · 구도) ============ -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Card.Elevated"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xl"
                    app:cardBackgroundColor="@color/maple_50"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_l">

                        <TextView
                            style="@style/Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/detail_shooting_info"
                            android:textColor="@color/maple_700" />

                        <TextView
                            android:id="@+id/tv_detail_best_time"
                            style="@style/Text.SectionTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:textColor="@color/maple_800"
                            tools:text="일몰 골든아워 · 서향" />

                        <TextView
                            android:id="@+id/tv_detail_facts_note"
                            style="@style/Text.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/maple_700"
                            tools:text="단풍터널은 역광이 살아나는 늦은 오후가 절정이에요" />

                        <TextView
                            android:id="@+id/tv_detail_guide"
                            style="@style/Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_m"
                            android:background="@drawable/bg_pill_dark"
                            android:paddingHorizontal="@dimen/space_m"
                            android:paddingVertical="@dimen/space_xs"
                            android:textColor="@color/white"
                            android:textStyle="bold"
                            tools:text="📷 추천 구도 · 삼분할 격자" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ============ 오디오 가이드 ============ -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_audio_guide"
                    style="@style/Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:text="@string/detail_audio_play"
                    app:backgroundTint="@color/moss_500"
                    app:icon="@drawable/ic_audio"
                    app:iconTint="@color/white" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_checkin"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/maple_600"
                        android:text="@string/detail_checkin" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_audio_speed"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_secondary"
                        tools:text="재생 속도 1.0×" />
                </LinearLayout>

                <!-- ============ 포토스코어 근거 ============ -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="24dp"
                    android:background="@color/divider" />

                <LinearLayout
                    android:id="@+id/layout_score_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/detail_score_reason"
                        android:textAppearance="@style/Text.SectionTitle" />

                    <TextView
                        android:id="@+id/tv_score_toggle"
                        style="@style/Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/detail_score_expand"
                        android:textColor="@color/maple_600" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_score_headline"
                    style="@style/Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    tools:text="지금 골든아워라 빛 조건에서 점수를 크게 받았어요" />

                <LinearLayout
                    android:id="@+id/layout_score_factors"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="24dp"
                    android:background="@color/divider" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/detail_section_info"
                    android:textAppearance="@style/Text.SectionTitle" />

                <TextView
                    android:id="@+id/tv_detail_tip"
                    style="@style/Text.Reading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:textSize="15sp"
                    tools:text="이곳은 삼분할 구도를 활용하여 배경과 인물을 배치할 때 가장 아름다운 사진을 얻을 수 있습니다." />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ================= 하단 고정 액션바 ================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_bar"
        android:elevation="12dp"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="20dp"
        android:weightSum="2">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_start_guide"
            style="@style/Button.Primary"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="@string/action_shoot"
            android:textColor="@color/white"
            app:backgroundTint="@color/maple_500"
            app:icon="@drawable/baseline_camera_alt_24"
            app:iconTint="@color/white" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_navigate"
            style="@style/Button.Primary"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="@string/action_navigate"
            android:textColor="@color/btn_secondary_text"
            app:backgroundTint="@color/btn_secondary_bg"
            app:icon="@drawable/ic_directions"
            app:iconTint="@color/btn_secondary_text" />
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
