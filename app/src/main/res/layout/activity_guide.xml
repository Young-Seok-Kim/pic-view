<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!--
      디버그 빌드에서만 쓰는 미리보기 대체 이미지.
      스토어 스크린샷을 찍을 때 실제 카메라 대신 풍경 사진을 깔기 위한 용도로,
      릴리즈 빌드에서는 절대 표시되지 않습니다.
    -->
    <ImageView
        android:id="@+id/iv_demo_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <com.youngs.picview.ui.guide.GuideOverlayView
        android:id="@+id/guideOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 상단 스크림 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_gravity="top"
        android:background="@drawable/bg_scrim_top" />

    <!-- 하단 스크림 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_scrim_bottom" />

    <!-- ================= 상단 바 ================= -->
    <LinearLayout
        android:id="@+id/layout_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_l"
        android:paddingTop="@dimen/space_m">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btn_guide_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_glass_circle"
                android:contentDescription="@string/cd_back"
                android:padding="9dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/tv_spot_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_m"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:shadowColor="#99000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="4"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="내장산 국립공원" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvGuideMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_l"
            android:background="@drawable/bg_pill_dark"
            android:paddingHorizontal="18dp"
            android:paddingVertical="10dp"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="선이 교차하는 지점에 피사체를 배치하세요" />
    </LinearLayout>

    <!-- ================= 하단 컨트롤 ================= -->
    <LinearLayout
        android:id="@+id/layout_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingTop="@dimen/space_l"
        android:paddingBottom="36dp">

        <!--
          ─────────── 포즈 추천 ───────────
          미리보기를 최대한 덜 가려야 하므로 제목 줄을 따로 두지 않고
          인원 칩 줄 오른쪽에 정렬 기준만 붙였습니다.
        -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/screen_padding"
            android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_people"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="6dp"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_people_solo"
                style="@style/Chip.Pose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/pose_group_solo" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_people_pair"
                style="@style/Chip.Pose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pose_group_pair" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_people_small"
                style="@style/Chip.Pose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pose_group_small" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_people_large"
                style="@style/Chip.Pose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pose_group_large" />
        </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_poses"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/screen_padding"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_pose" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="36dp"
            android:paddingTop="@dimen/space_l">

            <ImageButton
                android:id="@+id/btn_gallery"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="start|center_vertical"
                android:background="@drawable/bg_glass_circle"
                android:contentDescription="@string/cd_gallery"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/baseline_photo_library_24"
                app:tint="@color/white" />

            <ImageButton
                android:id="@+id/btn_capture"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_shutter_button"
                android:contentDescription="@string/cd_capture"
                android:src="@android:color/transparent" />
        </FrameLayout>
    </LinearLayout>

    <View
        android:id="@+id/flash_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@color/white"
        android:visibility="gone" />

</FrameLayout>
