<?xml version="1.0" encoding="utf-8"?>
<!-- 미션의 세 위치 사진 칸 하나 (현재 위치 · 두 걸음 가까이 · 좌우 이동). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_slot_number"
            style="@style/Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/maple_600"
            android:textStyle="bold"
            tools:text="01" />

        <TextView
            android:id="@+id/tv_slot_label"
            style="@style/Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            tools:text="현재 위치" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/frame_slot"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:layout_marginTop="@dimen/space_xs"
        android:background="@drawable/bg_detail_fact">

        <ImageView
            android:id="@+id/iv_slot_photo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/layout_slot_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:src="@drawable/baseline_camera_alt_24"
                app:tint="@color/text_tertiary" />

            <TextView
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/mission_add_photo"
                android:textColor="@color/text_tertiary"
                android:textSize="10sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
