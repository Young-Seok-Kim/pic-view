<?xml version="1.0" encoding="utf-8"?>
<!--
  현장 미션 한 줄.

  예전에는 체크박스 하나에 "제목\n설명"을 한꺼번에 넣었습니다. 현장에서
  해가 넘어가는 동안 두 줄씩 세 개를 읽는 사람은 없습니다.

  그래서 세 갈래로 나눴습니다.
    · 참고 사진 한 장  — 문장보다 빨리 읽힙니다
    · 할 일 한 줄      — 체크박스에 붙는 것은 이것뿐
    · 부연은 접어 둠   — 필요한 사람만 '더 알아보기'로 폅니다
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="@dimen/space_xs">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <CheckBox
            android:id="@+id/cb_step"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="0dp" />

        <ImageView
            android:id="@+id/iv_step_photo"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginEnd="@dimen/space_m"
            android:background="@drawable/bg_step_thumb"
            android:clipToOutline="true"
            android:contentDescription="@string/cd_mission_step_example"
            android:scaleType="centerCrop"
            tools:src="@drawable/guide_reflection" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_step_title"
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textStyle="bold"
                tools:text="실루엣의 기준점을 먼저 찾기" />

            <TextView
                android:id="@+id/tv_step_more"
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:paddingVertical="2dp"
                android:text="@string/mission_step_more"
                android:textColor="@color/maple_600" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tv_step_detail"
        style="@style/Text.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="52dp"
        android:layout_marginTop="@dimen/space_xs"
        android:background="@drawable/bg_detail_fact"
        android:padding="@dimen/space_m"
        android:textColor="@color/text_secondary"
        android:visibility="gone"
        tools:text="밝은 하늘 기준으로 노출 맞추기"
        tools:visibility="visible" />
</LinearLayout>
