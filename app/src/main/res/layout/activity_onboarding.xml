<?xml version="1.0" encoding="utf-8"?>
<!--
    온보딩 (NAVIGATION_FLOW §1).

    3장을 넘긴 뒤 마지막에서 사용 모드를 고릅니다.
    로그인·회원가입 단계는 없습니다 — 이 앱은 계정을 두지 않습니다.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_onboarding"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_onboarding_skip"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/space_s"
        android:text="@string/onboarding_skip"
        android:textColor="@color/text_tertiary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/pager_onboarding"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/btn_onboarding_skip"
        app:layout_constraintBottom_toTopOf="@id/layout_onboarding_dots"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/layout_onboarding_dots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_xl"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/layout_onboarding_actions"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 1·2장 : 다음 버튼 / 3장 : 모드 선택 두 버튼 -->
    <LinearLayout
        android:id="@+id/layout_onboarding_actions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/screen_padding"
        android:layout_marginBottom="@dimen/space_2xl"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_onboarding_next"
            style="@style/Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_next" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_onboarding_senior"
            style="@style/Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_target_senior"
            android:text="@string/onboarding_start_senior"
            android:visibility="gone"
            app:backgroundTint="@color/moss_500"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_onboarding_normal"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:minHeight="@dimen/touch_target"
            android:text="@string/onboarding_start_normal"
            android:visibility="gone"
            app:cornerRadius="@dimen/radius_button"
            tools:visibility="visible" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
