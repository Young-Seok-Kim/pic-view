<?xml version="1.0" encoding="utf-8"?>
<!--
  홈의 '빛이 맞는 출사' 카드 (시안 LIGHT MATCH).

  시안 그대로 카드 틀이 없습니다 — 위 얇은 검은 선 하나가 칸을 가르고,
  왼쪽에 작은 사진, 오른쪽에 시각 → 이름 → 빛 설명 → 계획 담기가
  쌓입니다. 카드의 첫 줄이 점수가 아니라 **시각**인 이유는 이 목록의
  약속이 "여기가 좋다"가 아니라 "몇 시에 가면 빛이 맞는다"여서입니다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="270dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/space_xl"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <!-- 칸을 가르는 얇은 선. 시안의 카드 경계는 테두리가 아니라 이 선입니다. -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/text_primary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_m"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="104dp"
            android:layout_height="92dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:id="@+id/iv_home_spot"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/bg_image_placeholder"
                    android:contentDescription="@string/cd_spot_thumbnail"
                    android:scaleType="centerCrop" />
            </com.google.android.material.card.MaterialCardView>

            <!-- 주제 칩. 사진 모서리에 흰 알약으로 얹습니다(시안 표기). -->
            <TextView
                android:id="@+id/tv_home_spot_theme"
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_marginStart="6dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_chip_match"
                android:maxLines="1"
                android:paddingHorizontal="@dimen/space_s"
                android:paddingVertical="2dp"
                android:textColor="@color/text_primary"
                android:textSize="10sp"
                tools:text="산·전망" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_m"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- 빛이 맞는 시각. 오늘 지나갔으면 내일로 넘어갑니다. -->
            <TextView
                android:id="@+id/tv_home_spot_time"
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:textColor="@color/maple_500"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="⏱ 내일 05:20" />

            <TextView
                android:id="@+id/tv_home_spot_title"
                style="@style/Text.SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="내장산 능선" />

            <!-- 그 시간의 빛이 무엇을 만드는지 한 줄. -->
            <TextView
                android:id="@+id/tv_home_spot_desc"
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/text_secondary"
                tools:text="푸른빛에서 첫 사광으로 이어져요" />

            <!-- 한 곳짜리 출사 일정으로 바로 저장. -->
            <LinearLayout
                android:id="@+id/layout_home_spot_plan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="2dp">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_place"
                    app:tint="@color/text_primary" />

                <TextView
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/home_spot_plan_add"
                    android:textColor="@color/text_primary" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
