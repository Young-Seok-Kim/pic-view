<?xml version="1.0" encoding="utf-8"?>
<!--
  홈의 '빛이 맞는 출사' 가로 카드 (시안 LIGHT MATCH).

  전 카드는 "★ 점수 + 주제/시간 알약"이었습니다. 시안은 점수 대신
  **몇 시에 가면 되는지**를 주황 글씨로 맨 위에 둡니다 — 이 목록의
  정렬 기준(빛이 맞는 순간이 가까운 곳)과 카드의 첫 줄이 같은 말을
  하게 하기 위해서입니다.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="@dimen/spot_card_width"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/space_m"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/bg_card"
    app:cardCornerRadius="@dimen/radius_card"
    app:cardElevation="0dp"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/spot_card_image_height">

            <ImageView
                android:id="@+id/iv_home_spot"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/bg_image_placeholder"
                android:contentDescription="@string/cd_spot_thumbnail"
                android:scaleType="centerCrop" />

            <!-- 주제 알약을 사진 위로. 지도 마커와 같은 색을 씁니다. -->
            <TextView
                android:id="@+id/tv_home_spot_theme"
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="@dimen/space_s"
                android:background="@drawable/bg_theme_pill"
                android:maxLines="1"
                android:paddingHorizontal="@dimen/space_s"
                android:paddingVertical="2dp"
                android:textStyle="bold"
                tools:text="산·전망" />
        </FrameLayout>

        <!-- 빛이 맞는 시각. 오늘 지나갔으면 내일로 넘어갑니다. -->
        <TextView
            android:id="@+id/tv_home_spot_time"
            style="@style/Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_m"
            android:layout_marginTop="@dimen/space_m"
            android:drawablePadding="4dp"
            android:gravity="center_vertical"
            android:textColor="@color/maple_500"
            android:textStyle="bold"
            tools:text="⏱ 내일 05:20" />

        <TextView
            android:id="@+id/tv_home_spot_title"
            style="@style/Text.SectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginHorizontal="@dimen/space_m"
            android:ellipsize="end"
            android:maxLines="1"
            tools:text="내장산 능선" />

        <!-- 그 시간의 빛이 무엇을 만드는지 한 줄. -->
        <TextView
            android:id="@+id/tv_home_spot_desc"
            style="@style/Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginHorizontal="@dimen/space_m"
            android:ellipsize="end"
            android:maxLines="2"
            android:minLines="2"
            android:textColor="@color/text_secondary"
            tools:text="푸른빛에서 첫 사광으로 이어져요" />

        <!-- 한 곳짜리 출사 일정으로 바로 저장. -->
        <LinearLayout
            android:id="@+id/layout_home_spot_plan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/space_m"
            android:paddingVertical="@dimen/space_s">

            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_place"
                app:tint="@color/text_secondary" />

            <TextView
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/home_spot_plan_add"
                android:textColor="@color/text_secondary" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
