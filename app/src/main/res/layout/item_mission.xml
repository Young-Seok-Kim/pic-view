<?xml version="1.0" encoding="utf-8"?>
<!-- 미션 하나. 완료 시 배지가 채워집니다. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_m"
    app:cardBackgroundColor="@color/bg_card"
    app:cardCornerRadius="@dimen/radius_card"
    app:cardElevation="0dp"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/space_l">

        <!-- 배지 -->
        <FrameLayout
            android:id="@+id/layout_mission_badge"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_mission_badge">

            <TextView
                android:id="@+id/tv_mission_emoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textSize="24sp"
                tools:text="🌇" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_m"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_mission_name"
                    style="@style/Text.SectionTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    tools:text="골든아워 사냥꾼" />

                <TextView
                    android:id="@+id/tv_mission_count"
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    tools:text="2 / 3" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_mission_req"
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                tools:text="일출 또는 일몰 골든아워에 세 곳에서 촬영하기" />

            <ProgressBar
                android:id="@+id/pb_mission"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="@dimen/space_s"
                android:max="100"
                android:progressDrawable="@drawable/bg_factor_bar"
                tools:progress="66" />

            <TextView
                android:id="@+id/tv_mission_badge_name"
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:background="@drawable/bg_score_chip"
                android:paddingHorizontal="@dimen/space_s"
                android:paddingVertical="2dp"
                android:textColor="@color/score_chip_text"
                android:textStyle="bold"
                tools:text="🏅 황금빛 수집가 획득" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
