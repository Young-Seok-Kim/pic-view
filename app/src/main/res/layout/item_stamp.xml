<?xml version="1.0" encoding="utf-8"?>
<!--
  스탬프 한 칸.

  그림 자체가 스탬프라 원형 바탕을 따로 두지 않습니다. 그림에 이미
  점선 테두리가 있어서, 그 위에 원을 또 그리면 테두리가 두 겹이 됩니다.
-->
<!--
  너비는 match_parent 여야 합니다. GridLayoutManager 가 한 칸 너비를 정해
  주는데, 0dp 로 두면(가중치도 없으니) 폭이 0 이 되어 격자가 통째로
  비어 보입니다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingVertical="@dimen/space_s">

    <!-- 상자 비율을 스탬프 원본(180:200)과 맞춥니다. 정사각형에 넣으면
         남는 여백만큼 그림이 작아 보이고, 칸마다 그 여백이 달라집니다. -->
    <ImageView
        android:id="@+id/iv_stamp_art"
        android:layout_width="72dp"
        android:layout_height="80dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        tools:src="@drawable/stamp_light_hunter" />

    <TextView
        android:id="@+id/tv_stamp_badge"
        style="@style/Text.Stamp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:gravity="center|top"
        android:ellipsize="end"
        android:maxLines="2"
        android:minLines="2"
        tools:text="황금빛 수집가" />

    <TextView
        android:id="@+id/tv_stamp_date"
        style="@style/Text.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="1"
        tools:text="8.12" />
</LinearLayout>
