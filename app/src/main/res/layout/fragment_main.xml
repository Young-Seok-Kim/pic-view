<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page">

    <!--
      헤더(제목 + 촬영 환경)는 스크롤하면 접히고,
      카테고리 필터 줄은 상단에 고정되어 언제든 바꿀 수 있게 했다.
    -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_page"
        android:stateListAnimator="@null"
        app:elevation="0dp"
        app:liftOnScroll="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/space_l"
            app:layout_scrollFlags="scroll|snap">

            <TextView
                android:id="@+id/tv_main_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/screen_padding"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/explore_title"
                android:textAppearance="@style/Text.Display" />

            <TextView
                android:id="@+id/tv_tagline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/screen_padding"
                android:layout_marginTop="2dp"
                android:text="@string/explore_sub"
                android:textAppearance="@style/Text.Caption" />

            <!--
              ── 지도 미리보기 (시안) ──
              실제 지도를 살아 있는 채로 넣으면 목록 스크롤과 지도 스크롤이
              싸웁니다. 시안처럼 길·물·핀만 그린 약도를 두고, 누르면 진짜
              지도로 넘어갑니다.
            -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_map_preview"
                android:layout_width="match_parent"
                android:layout_height="130dp"
                android:layout_marginHorizontal="@dimen/screen_padding"
                android:layout_marginTop="@dimen/space_l"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="#F2EDE4"
                app:cardCornerRadius="@dimen/radius_card"
                app:cardElevation="0dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <!-- 길 두 줄과 물길 하나. 정읍천이 시내를 가로지릅니다. -->
                    <View
                        android:layout_width="500dp"
                        android:layout_height="5dp"
                        android:layout_gravity="center"
                        android:background="#E4DCCE"
                        android:rotation="-14" />

                    <View
                        android:layout_width="400dp"
                        android:layout_height="4dp"
                        android:layout_gravity="center"
                        android:background="#E4DCCE"
                        android:rotation="52" />

                    <View
                        android:layout_width="480dp"
                        android:layout_height="12dp"
                        android:layout_gravity="center"
                        android:layout_marginTop="-22dp"
                        android:background="#BFD8E4"
                        android:rotation="-8" />

                    <TextView
                        style="@style/Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|center_horizontal"
                        android:layout_marginTop="18dp"
                        android:layout_marginStart="-120dp"
                        android:text="정읍천"
                        android:textColor="#7FA3B5"
                        android:textSize="10sp" />

                    <!--
                      핀 셋. 그린 그림이 아니라 지금 목록 맨 위 세 곳입니다.
                      정렬과 필터를 바꾸면 이름도 함께 바뀌고, 목록을 스크롤해
                      맨 위에 온 카드의 핀이 커집니다. 약도와 목록이 따로 놀면
                      위치 감각이 생기지 않습니다.
                    -->
                    <LinearLayout
                        android:id="@+id/layout_map_pin_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start|bottom"
                        android:layout_marginStart="26dp"
                        android:layout_marginBottom="14dp"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/iv_map_pin_1"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_place"
                            app:tint="@color/golden_300" />

                        <TextView
                            android:id="@+id/tv_map_pin_1"
                            style="@style/Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxWidth="96dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp"
                            tools:text="내장산 자락" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layout_map_pin_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginStart="-40dp"
                        android:layout_marginTop="-24dp"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/iv_map_pin_2"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_place"
                            app:tint="@color/eyebrow_blue" />

                        <TextView
                            android:id="@+id/tv_map_pin_2"
                            style="@style/Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxWidth="96dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp"
                            tools:text="정읍천" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layout_map_pin_3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="34dp"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/iv_map_pin_3"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_place"
                            app:tint="@color/maple_500" />

                        <TextView
                            android:id="@+id/tv_map_pin_3"
                            style="@style/Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxWidth="96dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp"
                            tools:text="정읍사공원" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/btn_map_expand"
                        style="@style/Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end|bottom"
                        android:layout_margin="@dimen/space_s"
                        android:background="@drawable/bg_chip_match"
                        android:paddingHorizontal="@dimen/space_m"
                        android:paddingVertical="4dp"
                        android:text="@string/map_expand"
                        android:textColor="@color/text_primary" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!--
          상단 고정 : 정렬 (시안 — 추천순 · 거리순 · 빛 좋은 시간순).
          카테고리는 오른쪽 필터 버튼 뒤로 옮겼습니다. 시안이 첫 줄에
          앉힌 물음은 "무엇을"이 아니라 **"어떤 순서로 볼까"**입니다.
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/bg_page"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="@dimen/space_s">

            <HorizontalScrollView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chip_group_sort"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/screen_padding"
                    app:chipSpacingHorizontal="8dp"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_sort_reco"
                        style="@style/Chip.Category"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/sort_reco"
                        app:chipIcon="@drawable/ic_star"
                        app:chipIconSize="14dp"
                        app:chipIconTint="@color/chip_content_selector"
                        app:chipIconVisible="true" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_sort_dist"
                        style="@style/Chip.Category"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sort_dist"
                        app:chipIcon="@drawable/ic_near_me"
                        app:chipIconSize="14dp"
                        app:chipIconTint="@color/chip_content_selector"
                        app:chipIconVisible="true" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_sort_light"
                        style="@style/Chip.Category"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sort_light"
                        app:chipIcon="@drawable/ic_sun"
                        app:chipIconSize="14dp"
                        app:chipIconTint="@color/chip_content_selector"
                        app:chipIconVisible="true" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <ImageView
                android:id="@+id/btn_category_filter"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:layout_marginEnd="@dimen/space_s"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_category_filter"
                android:padding="12dp"
                android:src="@drawable/ic_cat_all"
                app:tint="@color/text_secondary" />
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- ================= 촬영지 목록 ================= -->
    <!--
      당겨서 새로고침. 포토스코어는 골든아워·기온·강수에 따라 바뀌므로
      앱을 켜 둔 채 시간이 지나면 다시 계산해 줄 수 있어야 합니다.
    -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_photo_spots"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingTop="@dimen/space_s"
            android:paddingBottom="96dp"
            android:scrollbars="none"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:itemCount="3"
            tools:listitem="@layout/item_spot_card" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- ================= 빈 상태 ================= -->
    <LinearLayout
        android:id="@+id/layout_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingVertical="64dp"
        android:visibility="gone"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        tools:visibility="gone">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_empty_circle"
            android:contentDescription="@null"
            android:padding="18dp"
            android:src="@drawable/baseline_image_24"
            app:tint="@color/text_tertiary" />

        <TextView
            android:id="@+id/tv_empty_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:text="@string/empty_title"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_body"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_empty_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@string/empty_desc"
            android:textAppearance="@style/Text.Caption" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_retry"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:text="@string/retry"
            android:visibility="gone"
            app:cornerRadius="16dp" />
    </LinearLayout>

    <!--
      지도 FAB 는 시안대로 뺐습니다. 지도는 위 약도(지도 미리보기)를
      누르는 것으로 충분하고, FAB 는 카드의 시선 가이드 버튼을 가립니다.
    -->

    <!--
      로딩 표시. 기본 스피너 대신 빛 색 점 세 개가 물결처럼 이어집니다.
      기다리는 동안에도 이 앱이 무엇을 다루는지가 드러납니다.
    -->
    <com.youngs.picview.ui.widget.LightLoaderView
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"
        tools:visibility="visible" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
