<?xml version="1.0" encoding="utf-8"?>
<!--
    미션 & 기록.

    예전에는 "배지 2개 획득" 이 히어로였습니다. 그러면 이 화면이 수집판이
    되고, 사용자가 다음에 무엇을 할지는 스스로 찾아야 했습니다.

    지금은 **다음 촬영 행동을 고르는 화면**입니다. 위에서부터
    장면 진행 → 오늘의 추천 → 유형 필터 → 전체 목록 순입니다.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_mission"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page">

    <LinearLayout
        android:id="@+id/layout_mission_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/screen_padding"
        android:paddingVertical="@dimen/space_m"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btn_mission_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back"
            android:padding="9dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/text_primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_s"
            android:layout_weight="1"
            android:text="@string/mission_title"
            android:textAppearance="@style/Text.Title" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_3xl"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_mission_top">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!--
              ─────────── 장면 진행 ───────────
              "배지 2개" 가 아니라 "장면 3 / 17" 입니다. 배지는 받은 결과지만
              장면은 남긴 사진이라, 세는 단위가 앱의 성격을 말합니다.
            -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/screen_padding"
                app:cardBackgroundColor="@color/maple_500"
                app:cardCornerRadius="@dimen/radius_card"
                app:cardElevation="0dp">

                <!--
                  글과 그림을 겹쳐 둡니다. 그림은 오른쪽 끝에 배경으로
                  물러나 있고 글이 그 위를 지나갑니다. 나란히 두면 글이
                  들어갈 폭이 줄어 "장면 0 / 19" 가 두 줄이 됩니다.
                -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                <com.youngs.picview.ui.mission.MissionSceneView
                    android:layout_width="132dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="@dimen/space_m" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_l">

                    <TextView
                        android:id="@+id/tv_mission_summary"
                        style="@style/Text.Title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        tools:text="장면 3 / 17" />

                    <TextView
                        android:id="@+id/tv_mission_summary_desc"
                        style="@style/Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:textColor="#E6FFFFFF"
                        tools:text="정읍에서 발견한 장면을 모아보세요" />

                    <!--
                      진행 막대.
                      "0 / 19" 는 정확하지만 얼마만큼인지는 머리로 나눠야
                      압니다. 막대가 그 나눗셈을 대신합니다.
                    -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_m"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ProgressBar
                            android:id="@+id/pb_mission_total"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="0dp"
                            android:layout_height="6dp"
                            android:layout_weight="1"
                            android:max="100"
                            android:progressBackgroundTint="#4DFFFFFF"
                            android:progressTint="@color/white"
                            tools:progress="30" />

                        <TextView
                            android:id="@+id/tv_mission_percent"
                            style="@style/Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_s"
                            android:textColor="@color/white"
                            android:textStyle="bold"
                            tools:text="30%" />
                    </LinearLayout>

                    <!-- 유형별로 몇 장면을 모았는지. 무엇에 치우쳤는지 보입니다. -->
                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chips_mission_tally"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_m"
                        app:chipSpacingHorizontal="6dp"
                        app:chipSpacingVertical="0dp" />
                </LinearLayout>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!--
              ─────────── 오늘의 추천 ───────────
              목록 스물 몇 개 중에서 고르라고 하면 아무것도 안 고릅니다.
              지금 빛에서 바로 할 수 있는 하나를 위로 꺼내 둡니다.
            -->
            <TextView
                android:id="@+id/tv_today_label"
                style="@style/Text.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:layout_marginHorizontal="@dimen/screen_padding"
                android:text="@string/mission_today" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_today_mission"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:layout_marginHorizontal="@dimen/screen_padding"
                app:cardBackgroundColor="@color/maple_50"
                app:cardCornerRadius="@dimen/radius_card"
                app:cardElevation="0dp"
                app:strokeColor="@color/maple_300"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_l">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                    <FrameLayout
                        android:id="@+id/layout_today_badge"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_mission_circle">

                        <TextView
                            android:id="@+id/tv_today_icon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:textSize="19sp"
                            tools:text="☀" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_m"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_today_title"
                            style="@style/Text.SectionTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/maple_800"
                            tools:text="오늘의 빛 사냥꾼" />

                        <TextView
                            android:id="@+id/tv_today_desc"
                            style="@style/Text.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/maple_700"
                            tools:text="18:21 서향 · 지금 촬영지에서 바로 시작" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_today_go"
                        style="@style/Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mission_go"
                        android:textColor="@color/maple_600"
                        android:textStyle="bold" />
                    </LinearLayout>

                    <!--
                      추천 시간 · 구도 · 방향.
                      미션 이름만으로는 언제 어디서 어떻게인지 모릅니다.
                      셋을 한 줄에 두면 그대로 오늘의 계획이 됩니다.
                      값은 상세 화면과 같은 계산에서 나옵니다.
                    -->
                    <LinearLayout
                        android:id="@+id/layout_today_facts"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_m"
                        android:background="@drawable/bg_detail_fact"
                        android:baselineAligned="false"
                        android:orientation="horizontal"
                        android:padding="@dimen/space_m">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Text.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/mission_fact_time"
                                android:textColor="@color/text_tertiary"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/tv_today_time"
                                style="@style/Text.Body"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textStyle="bold"
                                tools:text="18:21-19:21" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Text.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/mission_fact_guide"
                                android:textColor="@color/text_tertiary"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/tv_today_guide"
                                style="@style/Text.Body"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textStyle="bold"
                                tools:text="⇆ 대칭" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Text.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/mission_fact_light"
                                android:textColor="@color/text_tertiary"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/tv_today_light"
                                style="@style/Text.Body"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textStyle="bold"
                                tools:text="☀ 저녁 사광" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!--
              ─────────── 유형 필터 ───────────
              미션이 스물 몇 개가 되면 목록이 아니라 탐색 화면이 됩니다.
              "빛을 보러 갈까 계절을 보러 갈까" 가 먼저 정해집니다.
            -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:paddingHorizontal="@dimen/screen_padding"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chips_mission_filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="6dp"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true" />
            </HorizontalScrollView>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_missions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:nestedScrollingEnabled="false"
                android:paddingHorizontal="@dimen/screen_padding"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="3"
                tools:listitem="@layout/item_mission" />

            <TextView
                android:id="@+id/tv_mission_empty"
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2xl"
                android:gravity="center"
                android:text="@string/mission_filter_empty"
                android:visibility="gone"
                tools:visibility="visible" />

            <!--
              ─────────── 스탬프북 ───────────
              위 목록이 "무엇을 할까" 라면 이 격자는 "얼마나 모았나" 입니다.
              같은 데이터지만 목록을 훑지 않고 한눈에 봅니다.
            -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/space_xl"
                android:layout_marginHorizontal="@dimen/screen_padding"
                android:background="@color/divider" />

            <TextView
                style="@style/Text.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:layout_marginHorizontal="@dimen/screen_padding"
                android:text="@string/stamp_book" />

            <TextView
                android:id="@+id/tv_stamp_count"
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/screen_padding"
                tools:text="8개 중 2개를 모았어요" />

            <!--
              나의 기록.
              미션이 "무엇을 할까" 라면 이 줄은 "지금까지 얼마나 했나"
              입니다. 숫자 넷이면 충분합니다.
            -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:layout_marginHorizontal="@dimen/screen_padding"
                android:background="@drawable/bg_detail_fact"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:padding="@dimen/space_m">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_stat_scenes"
                        style="@style/Text.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="0 / 19" />

                    <TextView
                        style="@style/Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mission_stat_scenes" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_stat_stamps"
                        style="@style/Text.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="0" />

                    <TextView
                        style="@style/Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mission_stat_stamps" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_stat_places"
                        style="@style/Text.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="0" />

                    <TextView
                        style="@style/Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mission_stat_places" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_stat_season"
                        style="@style/Text.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="여름" />

                    <TextView
                        style="@style/Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mission_stat_season" />
                </LinearLayout>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_stamps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:nestedScrollingEnabled="false"
                android:paddingHorizontal="@dimen/screen_padding"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                app:spanCount="3"
                tools:itemCount="8"
                tools:listitem="@layout/item_stamp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
