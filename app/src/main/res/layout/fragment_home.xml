<?xml version="1.0" encoding="utf-8"?>
<!--
    홈 — 오늘의 빛.

    시안(§HomeScreen)의 구조를 출사 기준으로 옮겼습니다.
    히어로 카드가 "AI 인사말"이 아니라 "지금 빛이 어떤가"를 말하고,
    실시간 현황 3카드도 인파·주차 대신 기온·하늘·다음 골든아워입니다.
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scroll_home"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/space_3xl">

        <!-- ─────────── 헤더 : 로고 + 날짜 알약 (시안) ─────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:layout_marginHorizontal="@dimen/screen_padding"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/Text.Display"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textColor="@color/maple_500"
                android:textSize="24sp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_home_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_target"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="21dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/space_l"
                    android:paddingEnd="@dimen/space_s">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_calendar"
                        app:tint="@color/maple_500" />

                    <TextView
                        android:id="@+id/tv_home_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_s"
                        android:fontFamily="@font/pretendard_semibold"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_body"
                        tools:text="2026.08.20 (목)" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="2dp"
                        android:contentDescription="@string/home_qa_calendar"
                        android:src="@drawable/baseline_chevron_right_24"
                        app:tint="@color/text_tertiary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- ─────────── 히어로 : 지금의 빛 ─────────── -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_light"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:layout_marginHorizontal="@dimen/screen_padding"
            app:cardBackgroundColor="@color/maple_500"
            app:cardCornerRadius="@dimen/radius_card"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_xl">

                <!--
                  머리말.
                  "지금은" 한 마디였던 자리를 보고서 제목처럼 바꿨습니다.
                  이 카드가 말하는 것이 인사말이 아니라 관측 결과라는 것을
                  먼저 알려야 아래 숫자들이 근거로 읽힙니다.
                -->
                <!--
                  머리말 줄 오른쪽에 하늘 상태를 답니다.
                  맑음·흐림은 취향이 아니라 조건입니다. 맑으면 한낮 하늘이
                  하얗게 날아가고, 흐리면 온 하늘이 소프트박스가 되어 인물과
                  숲의 결이 삽니다. 빛 보고서 옆이 그 말을 할 자리입니다.
                -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_light_eyebrow"
                        style="@style/Text.Caption"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:letterSpacing="0.12"
                        android:textColor="#99FFFFFF"
                        android:textSize="10sp"
                        android:text="@string/home_eyebrow_report" />

                    <TextView
                        android:id="@+id/tv_light_sky"
                        style="@style/Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill_dark"
                        android:paddingHorizontal="@dimen/space_s"
                        android:paddingVertical="2dp"
                        android:textColor="@color/white"
                        tools:text="☀ 맑음" />
                </LinearLayout>

                <!--
                  지금 시각과 방금 지난 태양 사건.
                  "야간"만으로는 밤이 시작된 참인지 새벽에 가까운지 알 수
                  없습니다. "일몰 후 58분" 이 그 자리를 메웁니다.
                -->
                <TextView
                    android:id="@+id/tv_light_now"
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:textColor="#CCFFFFFF"
                    tools:text="● 지금 20:20 · 일몰 후 58분" />

                <TextView
                    android:id="@+id/tv_light_phase"
                    style="@style/Text.Display.Report"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:textColor="@color/white"
                    tools:text="지금은 야간이에요." />

                <TextView
                    android:id="@+id/tv_light_hint"
                    style="@style/Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#E6FFFFFF"
                    tools:text="조명과 별빛을 담기 좋은 시간입니다." />

                <!--
                  다음 출사 적기.
                  밤에 앱을 여는 사람이 알고 싶은 건 오늘이 끝났다는 사실이
                  아니라 내일 몇 시에 나가야 하는가 입니다.
                -->
                <TextView
                    android:id="@+id/tv_light_next"
                    style="@style/Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#E6FFFFFF"
                    tools:text="다음 출사 적기는 내일 05:21, 첫 푸른빛부터 시작돼요." />

                <TextView
                    android:id="@+id/tv_next_golden"
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:background="@drawable/bg_pill_dark"
                    android:paddingHorizontal="@dimen/space_m"
                    android:paddingVertical="@dimen/space_xs"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    tools:text="⏱ 다음 촬영 적기까지 8시간 40분" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_home_plan"
            style="@style/Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/screen_padding"
            android:layout_marginTop="@dimen/space_m"
            android:text="@string/home_plan_now" />

        <!-- ─────────── 지금 가면 좋은 곳 (시안 LIGHT MATCH) ─────────── -->
        <LinearLayout
            android:id="@+id/layout_home_best"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2xl"
            android:layout_marginHorizontal="@dimen/screen_padding"
            android:orientation="vertical">

            <TextView
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.12"
                android:text="@string/home_best_eyebrow"
                android:textColor="@color/maple_600"
                android:textSize="10sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Text.SectionTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/home_best_now" />

                <TextView
                    android:id="@+id/tv_home_best_more"
                    android:minHeight="@dimen/touch_target"
                    android:minWidth="@dimen/touch_target"
                    android:gravity="center"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_see_all"
                    android:textColor="@color/maple_600" />
            </LinearLayout>
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_home_best"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/screen_padding"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:itemCount="3"
            tools:listitem="@layout/item_home_spot" />

        <!-- ─────────── 하루의 빛 막대 ─────────── -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Card.Elevated"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:layout_marginHorizontal="@dimen/screen_padding">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_l">

                <TextView
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.12"
                    android:textColor="@color/maple_600"
                    android:textSize="10sp"
                    android:text="@string/home_eyebrow_flow" />

                <TextView
                    style="@style/Text.SectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_s"
                    android:text="@string/home_day_light" />

                <com.youngs.picview.ui.home.SunArcView
                    android:id="@+id/view_day_light"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <!--
                  낮 길이.
                  숫자가 아니라 문장으로 둡니다. 위의 그림이 이미 근거를 다
                  보여 줬으니 여기서는 오늘 하루를 한 마디로 닫아 주면 됩니다.
                -->
                <TextView
                    android:id="@+id/tv_daylight_line"
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/space_s"
                    android:background="@drawable/bg_pill_soft"
                    android:paddingHorizontal="@dimen/space_l"
                    android:paddingVertical="@dimen/space_s"
                    tools:text="🌿  오늘은 13시간 31분 동안 빛이 머물러요" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ─────────── 기온 ─────────── -->
        <include
            android:id="@+id/stat_weather"
            layout="@layout/item_home_weather"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:layout_marginHorizontal="@dimen/screen_padding" />

        <!--
          ─────────── 빠른 이동 ───────────
          전에는 넓은 버튼 두 개였습니다. 버튼은 "누르면 뭔가 실행된다"는
          신호라 화면 이동에는 무겁고, 두 개뿐이라 나머지 기능이 묻혔습니다.
          시안(QA_0~3)처럼 색 타일 넷으로 바꿔 이동 지점이 한눈에 보이게 했습니다.
        -->
        <LinearLayout
            android:id="@+id/layout_quick_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:layout_marginHorizontal="@dimen/screen_padding"
            android:baselineAligned="false"
            android:orientation="horizontal" />

        <!--
          ─────────── 시선 가이드 진입 배너 ───────────

          사진 목록이 "어디를"에 답했으니 그 바로 아래에서 "어떻게"로
          잇습니다. 위 카드에서 고른 곳이 있든 없든, 오늘의 빛에 맞는
          구도 설명은 시선 가이드 한 화면이 전담합니다.
        -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_guide_entry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:layout_marginHorizontal="@dimen/screen_padding"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/maple_50"
            app:cardCornerRadius="@dimen/radius_card"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/space_l">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.12"
                        android:text="@string/home_guide_eyebrow"
                        android:textColor="@color/eyebrow_blue"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_guide_banner_title"
                        style="@style/Text.SectionTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:text="@string/home_guide_title"
                        android:textColor="@color/maple_800"
                        android:textSize="@dimen/text_title" />

                    <TextView
                        style="@style/Text.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:text="@string/home_guide_sub"
                        android:textColor="@color/maple_700" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_guide_open"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_m"
                    android:minWidth="0dp"
                    android:text="@string/home_guide_open"
                    android:textColor="@color/maple_600"
                    app:backgroundTint="@color/bg_card"
                    app:cornerRadius="@dimen/radius_button"
                    app:strokeColor="@color/maple_300" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_light_studio"
            style="@style/Button.Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/screen_padding"
            android:layout_marginTop="@dimen/space_m"
            android:text="@string/light_studio_open" />

        <ProgressBar
            android:id="@+id/progress_home"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_xl"
            android:indeterminateTint="@color/maple_500"
            android:visibility="gone"
            tools:visibility="visible" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
