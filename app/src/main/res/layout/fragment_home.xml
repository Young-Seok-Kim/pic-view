<?xml version="1.0" encoding="utf-8"?>
<!--
    홈 — 오늘의 빛.

    시안(§HomeScreen)의 구조를 출사 기준으로 옮겼습니다.
    히어로 카드가 "AI 인사말"이 아니라 "지금 빛이 어떤가"를 말하고,
    실시간 현황 3카드도 인파·주차 대신 기온·하늘·다음 골든아워입니다.
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scroll_home"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/space_3xl">

        <!-- ─────────── 헤더 ─────────── -->
        <TextView
            android:id="@+id/tv_home_date"
            style="@style/Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:layout_marginHorizontal="@dimen/screen_padding"
            tools:text="8월 4일 화요일" />

        <TextView
            android:id="@+id/tv_home_title"
            style="@style/Text.Display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/screen_padding"
            android:text="@string/app_name" />

        <!-- ─────────── 히어로 : 지금의 빛 ─────────── -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_light"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:layout_marginHorizontal="@dimen/screen_padding"
            app:cardBackgroundColor="@color/maple_500"
            app:cardCornerRadius="@dimen/radius_card"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_xl">

                <TextView
                    android:id="@+id/tv_light_phase_label"
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#CCFFFFFF"
                    tools:text="지금은" />

                <TextView
                    android:id="@+id/tv_light_phase"
                    style="@style/Text.Display"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    tools:text="한낮" />

                <TextView
                    android:id="@+id/tv_light_hint"
                    style="@style/Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#E6FFFFFF"
                    tools:text="빛이 강해 실내가 유리해요" />

                <TextView
                    android:id="@+id/tv_next_golden"
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:background="@drawable/bg_pill_dark"
                    android:paddingHorizontal="@dimen/space_m"
                    android:paddingVertical="@dimen/space_xs"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    tools:text="🌇 일몰 골든아워까지 9시간 0분" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ─────────── 하루의 빛 막대 ─────────── -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Card.Elevated"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:layout_marginHorizontal="@dimen/screen_padding">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_l">

                <TextView
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_s"
                    android:text="@string/home_day_light" />

                <com.youngs.picview.ui.home.DayLightBarView
                    android:id="@+id/view_day_light"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ─────────── 현재 촬영 조건 3카드 ─────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:layout_marginHorizontal="@dimen/screen_padding"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <include
                android:id="@+id/stat_temp"
                layout="@layout/item_home_stat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <include
                android:id="@+id/stat_sky"
                layout="@layout/item_home_stat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_s"
                android:layout_weight="1" />

            <include
                android:id="@+id/stat_spots"
                layout="@layout/item_home_stat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_s"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- ─────────── 주요 액션 ─────────── -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_home_make_course"
            style="@style/Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:layout_marginHorizontal="@dimen/screen_padding"
            android:text="@string/home_make_course" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:layout_marginHorizontal="@dimen/screen_padding"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_home_map"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="@dimen/touch_target"
                android:text="@string/home_open_map"
                app:cornerRadius="@dimen/radius_button" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_home_calendar"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_s"
                android:layout_weight="1"
                android:minHeight="@dimen/touch_target"
                android:text="@string/calendar_entry"
                app:cornerRadius="@dimen/radius_button" />
        </LinearLayout>

        <!-- ─────────── 지금 찍기 좋은 곳 ─────────── -->
        <LinearLayout
            android:id="@+id/layout_home_best"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2xl"
            android:layout_marginHorizontal="@dimen/screen_padding"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/Text.SectionTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/home_best_now" />

            <TextView
                android:id="@+id/tv_home_best_more"
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_see_all"
                android:textColor="@color/maple_600" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_home_best"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/screen_padding"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:itemCount="3"
            tools:listitem="@layout/item_home_spot" />

        <ProgressBar
            android:id="@+id/progress_home"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_xl"
            android:indeterminateTint="@color/maple_500"
            android:visibility="gone"
            tools:visibility="visible" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
