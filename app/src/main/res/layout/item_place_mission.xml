<?xml version="1.0" encoding="utf-8"?>
<!--
    이 장소에서 지금 할 수 있는 미션 한 줄.

    전체 미션 카드보다 얇습니다. 여기서는 "무엇을 할까"를 고르는 것이
    아니라 "지금 이거 할래?"에 답하는 것이라, 설명은 짧고 진행률만
    또렷하면 됩니다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/row_place_mission"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="@dimen/space_m">

    <FrameLayout
        android:id="@+id/layout_place_mission_icon"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@drawable/bg_mission_circle">

        <TextView
            android:id="@+id/tv_place_mission_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textSize="15sp"
            tools:text="☀" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_m"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_place_mission_title"
            style="@style/Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textStyle="bold"
            tools:text="오늘의 빛 사냥꾼" />

        <TextView
            android:id="@+id/tv_place_mission_hint"
            style="@style/Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            tools:text="다음 황금시간에 한 장 더 남겨보세요" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_place_mission_count"
        style="@style/Text.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_s"
        android:textStyle="bold"
        tools:text="1 / 2" />
</LinearLayout>
