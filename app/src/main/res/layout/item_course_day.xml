<?xml version="1.0" encoding="utf-8"?>
<!--
  코스 타임라인의 날짜 구분선.

  타임라인이 시각(13:42 · 15:33)만 말하면 그것이 **어느 날의 13시인지**
  알 수 없습니다. 지금은 하루짜리 코스뿐이라 헷갈릴 일이 적지만, 지역을
  넓히면 1박 2일 코스가 나오고 그때는 "둘째 날 06시"와 "첫날 06시"가
  같은 줄로 보이게 됩니다.

  그래서 타임라인 자체가 날짜를 말합니다 — 맨 앞에 한 번, 그리고 날이
  바뀌는 자리마다 한 번 더.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/screen_padding"
    android:paddingTop="@dimen/space_s"
    android:paddingBottom="@dimen/space_m">

    <!--
      왼쪽 폭(64dp)은 정거장 줄의 시각 칸과 같습니다.
      날짜와 시각이 같은 세로선 위에 서야 축으로 읽힙니다.
    -->
    <TextView
        android:id="@+id/tv_day_label"
        style="@style/Text.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_day_chip"
        android:paddingHorizontal="@dimen/space_m"
        android:paddingVertical="4dp"
        android:textColor="@color/maple_700"
        android:textStyle="bold"
        tools:text="첫날 · 9월 11일 (금)" />

    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginStart="@dimen/space_m"
        android:layout_weight="1"
        android:background="@color/divider" />
</LinearLayout>
