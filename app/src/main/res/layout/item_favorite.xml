<?xml version="1.0" encoding="utf-8"?>
<!--
  찜한 촬영지 한 줄.

  '다녀옴 / 아직'을 오른쪽 위에 두는 것이 이 카드의 요점입니다. 찜 목록은
  가만히 두면 쌓이기만 하는데, 무엇이 남았는지 보이면 다시 나가게 됩니다.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_favorite"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_m"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/bg_card"
    app:cardCornerRadius="@dimen/radius_card"
    app:cardElevation="0dp"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/space_m">

        <ImageView
            android:id="@+id/iv_favorite"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@color/bg_image_placeholder"
            android:contentDescription="@string/cd_spot_thumbnail"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_m"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_favorite_title"
                style="@style/Text.SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="정읍사예술회관" />

            <TextView
                android:id="@+id/tv_favorite_signal"
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_secondary"
                tools:text="오후 · 길어진 그림자 · 건축선" />

            <TextView
                android:id="@+id/tv_favorite_nudge"
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/maple_600"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="지금 빛과 맞아요"
                tools:visibility="visible" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_favorite_state"
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_state_badge"
                android:paddingHorizontal="@dimen/space_s"
                android:paddingVertical="2dp"
                android:textStyle="bold"
                tools:text="다녀옴" />

            <ImageView
                android:id="@+id/btn_favorite_remove"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginTop="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/favorites_remove"
                android:padding="8dp"
                android:src="@drawable/ic_heart_filled"
                app:tint="@color/maple_500" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
