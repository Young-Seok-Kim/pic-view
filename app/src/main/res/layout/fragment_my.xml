<?xml version="1.0" encoding="utf-8"?>
<!--
    MY — 나의 시선 (시안 개편).

    시안의 프로필(아바타·레벨·가입일)과 고객센터는 두지 않습니다.
    로그인이 없는 앱이라 계정이 아니라 **기록**이 곧 프로필이고,
    응대 창구가 없는데 고객센터 버튼만 있으면 거짓말이 됩니다.
    대신 머리에 "로컬 저장 · 로그인 없음"을 배지로 밝힙니다.

    오늘의 시선(지금 나가야 할 이유) → 이번 달의 촬영 리듬 →
    최근 촬영 아카이브 · 나의 촬영 성향 → 다음에 가볼 정읍 →
    빛 수집 노트 → 사진 내보내기 · 데이터 초기화 · 접근성 순서입니다.

    위에서 아래로 갈수록 시간축이 넓어집니다. 지금 → 이번 달 → 다음 계절 →
    모아 온 전부. 마지막 줄만 기록이 아니라 기록을 다루는 일입니다.
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scroll_my"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_padding"
        android:paddingBottom="@dimen/space_3xl">

        <!-- ─────────── 머리 : 제목 · 로컬 저장 배지 · 설정 ─────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.Display"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/my_title" />

                <TextView
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/my_subtitle" />
            </LinearLayout>

            <!--
                로그인이 없다는 사실은 숨길 일이 아니라 이 앱의 약속입니다.
                눌러도 아무 일이 없어야 맞습니다 — 상태 표시이지 버튼이 아닙니다.
            -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_outline"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/space_m"
                android:paddingVertical="6dp">

                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_lock"
                    app:tint="@color/maple_500" />

                <TextView
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="@string/my_local_badge"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btn_my_settings"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="@dimen/space_xs"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_my_settings"
                android:padding="8dp"
                android:src="@drawable/ic_settings"
                app:tint="@color/text_primary" />
        </LinearLayout>

        <!-- ─────────── 오늘의 시선 ─────────── -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_today"
            style="@style/Card.Elevated"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            app:cardBackgroundColor="@color/golden_100">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="168dp">

                <!-- 사진이 오른쪽 절반을 채웁니다. 글은 왼쪽에서 끊기지 않습니다. -->
                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guide_today"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent="0.46" />

                <ImageView
                    android:id="@+id/iv_today_photo"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:background="@color/bg_image_placeholder"
                    android:contentDescription="@string/cd_my_hero_photo"
                    android:scaleType="centerCrop"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@id/guide_today"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:src="@drawable/spot_uhwajeong" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_l"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/guide_today"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        style="@style/Text.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/my_today_title" />

                    <!-- 날씨 · 날짜 -->
                    <TextView
                        android:id="@+id/tv_today_meta"
                        style="@style/Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:drawablePadding="4dp"
                        android:gravity="center_vertical"
                        app:drawableStartCompat="@drawable/ic_sun"
                        app:drawableTint="@color/golden_600"
                        tools:text="흐림 · 8월 26일" />

                    <!-- 석양까지 남은 시간 -->
                    <TextView
                        android:id="@+id/tv_today_countdown"
                        style="@style/Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:drawablePadding="4dp"
                        android:gravity="center_vertical"
                        android:textColor="@color/golden_700"
                        android:textStyle="bold"
                        app:drawableStartCompat="@drawable/ic_sun"
                        app:drawableTint="@color/golden_600"
                        tools:text="석양까지 58분" />

                    <TextView
                        android:id="@+id/tv_today_line"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_m"
                        android:fontFamily="@font/pretendard_semibold"
                        android:lineSpacingExtra="3dp"
                        android:maxLines="3"
                        android:ellipsize="end"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        tools:text="수면의 반사광을 따라 두 걸음 이동해보세요." />

                    <TextView
                        android:id="@+id/tv_today_place"
                        style="@style/Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_m"
                        android:background="@drawable/bg_pill_outline"
                        android:drawablePadding="4dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:paddingHorizontal="@dimen/space_m"
                        android:paddingVertical="5dp"
                        android:textColor="@color/text_primary"
                        app:drawableStartCompat="@drawable/ic_place"
                        app:drawableTint="@color/maple_500"
                        tools:text="내장산 우화정" />
                </LinearLayout>

                <!-- 사진 위에 얹히는 CTA. 시안 그대로 카드 오른쪽 아래입니다. -->
                <!--
                    사진 위에 얹히는 작은 알약.

                    처음에는 브랜드색 꽉 찬 버튼이었는데, 실제 사진 위에서는
                    색이 너무 세서 정작 봐야 할 장면을 눌렀습니다. 어두운
                    반투명으로 가라앉히고 폭도 글자에 맞춰 줄입니다 —
                    사진 절반을 가로지르는 막대일 이유가 없습니다.
                -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_today_shoot"
                    style="@style/Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_m"
                    android:layout_marginBottom="@dimen/space_m"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="@dimen/space_m"
                    android:paddingVertical="9dp"
                    android:text="@string/my_today_cta"
                    android:textSize="12sp"
                    app:backgroundTint="@color/btn_on_photo"
                    app:cornerRadius="@dimen/radius_pill"
                    app:icon="@drawable/ic_camera"
                    app:iconGravity="textStart"
                    app:iconPadding="5dp"
                    app:iconSize="14dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ─────────── 이번 달의 촬영 리듬 ─────────── -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Card.Elevated"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_l">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Text.SectionTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/my_rhythm_title" />

                    <!-- 이 숫자가 어디서 왔는지 밝히는 자리. 서버 통계가 아닙니다. -->
                    <TextView
                        style="@style/Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/my_rhythm_basis" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/layout_stat_courses"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="@dimen/space_s">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_map_route"
                                app:tint="@color/maple_500" />

                            <TextView
                                style="@style/Text.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="5dp"
                                android:text="@string/my_saved_courses"
                                android:textColor="@color/text_secondary" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_stat_course"
                            style="@style/Text.Display"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/maple_600"
                            tools:text="1" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:layout_marginVertical="@dimen/space_s"
                        android:background="@color/divider" />

                    <LinearLayout
                        android:id="@+id/layout_stat_shots"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="@dimen/space_s">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_camera"
                                app:tint="@color/golden_600" />

                            <TextView
                                style="@style/Text.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="5dp"
                                android:text="@string/my_stat_shots"
                                android:textColor="@color/text_secondary" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_stat_shots"
                            style="@style/Text.Display"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/golden_600"
                            tools:text="3" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:layout_marginVertical="@dimen/space_s"
                        android:background="@color/divider" />

                    <LinearLayout
                        android:id="@+id/layout_stat_missions"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="@dimen/space_s">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_target"
                                app:tint="@color/maple_400" />

                            <TextView
                                style="@style/Text.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="5dp"
                                android:text="@string/my_stat_missions_done"
                                android:textColor="@color/text_secondary" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_stat_mission"
                            style="@style/Text.Display"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/maple_400"
                            tools:text="2" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ─────────── 최근 촬영 아카이브 · 나의 촬영 성향 ─────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                style="@style/Card.Elevated"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="5dp"
                android:layout_weight="1.35">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_m">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Text.SectionTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/my_archive_title"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/tv_archive_all"
                            style="@style/Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pill_outline"
                            android:paddingHorizontal="@dimen/space_s"
                            android:paddingVertical="3dp"
                            android:text="@string/my_archive_all"
                            android:textColor="@color/maple_600" />
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_my_photos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_s"
                        android:nestedScrollingEnabled="false"
                        tools:itemCount="4"
                        tools:listitem="@layout/item_my_photo" />

                    <!-- 사진이 없을 때. 남의 사진으로 채우지 않습니다. -->
                    <LinearLayout
                        android:id="@+id/layout_archive_empty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_s"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="@dimen/space_l"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <ImageView
                            android:layout_width="60dp"
                            android:layout_height="50dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_archive_empty" />

                        <TextView
                            style="@style/Text.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_s"
                            android:gravity="center"
                            android:text="@string/my_archive_empty" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Card.Elevated"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/bg_card_muted">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_m">

                    <TextView
                        style="@style/Text.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/my_taste_title"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tv_taste_basis"
                        style="@style/Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        tools:text="사진 12장 기준" />

                    <!-- 세 축은 코드에서 채웁니다. 아이콘은 축 이름과 함께 답니다. -->
                    <include
                        android:id="@+id/taste_reflection"
                        layout="@layout/item_taste_axis"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_m" />

                    <include
                        android:id="@+id/taste_golden"
                        layout="@layout/item_taste_axis"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_s" />

                    <include
                        android:id="@+id/taste_water"
                        layout="@layout/item_taste_axis"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_s" />

                    <View
                        android:id="@+id/divider_taste"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="@dimen/space_m"
                        android:background="@color/divider" />

                    <TextView
                        android:id="@+id/tv_taste_insight"
                        style="@style/Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_m"
                        android:textSize="13sp"
                        tools:text="해가 낮아질수록 셔터를 자주 누르는 편이에요." />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- ─────────── 다음에 가볼 정읍 ─────────── -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_next"
            style="@style/Card.Elevated"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_l">

                <TextView
                    style="@style/Text.SectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/my_next_title" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/iv_next_photo"
                        android:layout_width="96dp"
                        android:layout_height="72dp"
                        android:background="@color/bg_image_placeholder"
                        android:contentDescription="@string/cd_my_next_photo"
                        android:scaleType="centerCrop"
                        app:shapeAppearanceOverlay="@style/Shape.Thumb"
                        tools:src="@drawable/highlight_gujeolcho" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_m"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:baselineAligned="false"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tv_next_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:fontFamily="@font/pretendard_semibold"
                                android:maxLines="1"
                                android:textColor="@color/text_primary"
                                android:textSize="15sp"
                                tools:text="구절초 지방정원" />

                            <TextView
                                android:id="@+id/tv_next_dday"
                                style="@style/Text.Caption"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textColor="@color/maple_500"
                                tools:text="· 절정 전 25일" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_next_tip"
                            style="@style/Text.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:ellipsize="end"
                            android:maxLines="3"
                            android:textSize="13sp"
                            tools:text="역광으로 담으면 흰 꽃잎이 투명하게 빛납니다." />
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_next_plan"
                    style="@style/Button.Tonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:text="@string/my_next_cta"
                    app:icon="@drawable/ic_map_route"
                    app:iconGravity="textStart" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ─────────── 빛 수집 노트 ─────────── -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_light_note"
            style="@style/Card.Elevated"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_l">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Text.SectionTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/my_light_note" />

                    <TextView
                        android:id="@+id/tv_light_note_count"
                        style="@style/Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:textColor="@color/maple_600"
                        android:textStyle="bold"
                        tools:text="2 / 8" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_light_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    tools:itemCount="4"
                    tools:listitem="@layout/item_light_note"
                    tools:orientation="horizontal" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ─────────── 사진 내보내기 · 데이터 초기화 · 접근성 ─────────── -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Card.Elevated"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/layout_export"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingVertical="@dimen/space_l">

                    <ImageView
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_export"
                        app:tint="@color/text_secondary" />

                    <TextView
                        style="@style/Text.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:text="@string/my_export"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:layout_marginVertical="@dimen/space_m"
                    android:background="@color/divider" />

                <LinearLayout
                    android:id="@+id/layout_reset"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingVertical="@dimen/space_l">

                    <ImageView
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_reset"
                        app:tint="@color/text_secondary" />

                    <TextView
                        style="@style/Text.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:text="@string/my_reset"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:layout_marginVertical="@dimen/space_m"
                    android:background="@color/divider" />

                <LinearLayout
                    android:id="@+id/layout_quick_access"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingVertical="@dimen/space_l">

                    <ImageView
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_accessibility"
                        app:tint="@color/text_secondary" />

                    <TextView
                        style="@style/Text.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:text="@string/my_accessibility"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
