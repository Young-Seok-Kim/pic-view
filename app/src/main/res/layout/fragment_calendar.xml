<?xml version="1.0" encoding="utf-8"?>
<!-- 사계절 촬영 캘린더. 축제가 아니라 '피사체의 절정 시기'가 기준입니다. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_calendar"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page">

    <LinearLayout
        android:id="@+id/layout_calendar_top"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_m"
        android:paddingVertical="@dimen/space_s"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btn_calendar_back"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/text_primary" />

        <TextView
            style="@style/Text.SectionTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xs"
            android:layout_weight="1"
            android:text="@string/calendar_title" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_3xl"
        app:layout_constraintTop_toBottomOf="@id/layout_calendar_top"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!--
              지금 절정 / 다음 절정 히어로.
              배경 그림이 고른 계절을 따라 바뀝니다(봄 장밋빛 · 여름 숲 ·
              가을 단풍 · 겨울 설경). 코드가 계절에 맞춰 갈아 끼웁니다.
            -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_calendar_now"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/screen_padding"
                app:cardCornerRadius="@dimen/radius_card"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/iv_calendar_hero"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="fitXY"
                        tools:src="@drawable/bg_season_summer" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_xl">

                        <TextView
                            android:id="@+id/tv_calendar_dday"
                            style="@style/Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pill_dark"
                            android:paddingHorizontal="@dimen/space_m"
                            android:paddingVertical="@dimen/space_xs"
                            android:textColor="@color/hero_accent"
                            android:textStyle="bold"
                            tools:text="지금이 절정" />

                        <TextView
                            android:id="@+id/tv_calendar_now_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_s"
                            android:fontFamily="@font/pretendard_bold"
                            android:letterSpacing="-0.02"
                            android:textColor="@color/white"
                            android:textSize="26sp"
                            tools:text="내장산 여름 계곡" />

                        <TextView
                            android:id="@+id/tv_calendar_now_period"
                            style="@style/Text.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/pretendard_semibold"
                            android:textColor="#F2FFFFFF"
                            tools:text="7월 15일 ~ 8월 25일 · 평년 기준" />

                        <TextView
                            android:id="@+id/tv_calendar_now_tip"
                            style="@style/Text.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_s"
                            android:textColor="#E6FFFFFF"
                            tools:text="숲속은 빛이 부족합니다. 흐린 날 장노출로 물을 부드럽게 담아보세요." />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_calendar_point"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_m"
                            android:minHeight="42dp"
                            android:text="@string/calendar_point_view"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            app:cornerRadius="12dp"
                            app:strokeColor="#99FFFFFF" />
                    </LinearLayout>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 시즌 탭 -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chips_season"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:paddingHorizontal="@dimen/screen_padding"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_spring"
                    style="@style/Chip.Season.Spring"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/season_spring" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_summer"
                    style="@style/Chip.Season.Summer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/season_summer" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_autumn"
                    style="@style/Chip.Season.Autumn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/season_autumn" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_winter"
                    style="@style/Chip.Season.Winter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/season_winter" />
            </com.google.android.material.chip.ChipGroup>

            <!-- ─────────── 오늘의 촬영 지수 · 일출 · 습도 ─────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:layout_marginHorizontal="@dimen/screen_padding"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    style="@style/Card.Elevated"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1.2">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="@dimen/space_m">

                        <TextView
                            style="@style/Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/calendar_stat_index"
                            android:textSize="10sp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tv_stat_index"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/pretendard_bold"
                                android:textColor="@color/maple_500"
                                android:textSize="24sp"
                                tools:text="86" />

                            <TextView
                                android:id="@+id/tv_stat_index_label"
                                style="@style/Text.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:textColor="@color/maple_600"
                                android:textStyle="bold"
                                tools:text="좋음" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Card.Elevated"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="4dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="@dimen/space_m">

                        <TextView
                            style="@style/Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/calendar_stat_sun"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/tv_stat_sun"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/pretendard_bold"
                            android:fontFeatureSettings="tnum"
                            android:textColor="@color/golden_600"
                            android:textSize="22sp"
                            tools:text="05:55" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Card.Elevated"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="@dimen/space_m">

                        <TextView
                            style="@style/Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/calendar_stat_humidity"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/tv_stat_humid"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/pretendard_bold"
                            android:fontFeatureSettings="tnum"
                            android:textColor="@color/mission_weather"
                            android:textSize="22sp"
                            tools:text="55%" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!--
              ─────────── 월 달력 ───────────
              절정 기간이 며칠에 걸쳐 있는지는 목록만으로 감이 오지 않습니다.
              "10월 19~21일" 이라고 읽는 것과 달력에서 그 사흘에 점이 찍힌 걸
              보는 것은 다릅니다.
            -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Card.Elevated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:layout_marginHorizontal="@dimen/screen_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="@dimen/space_m">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/space_l">

                        <ImageView
                            android:id="@+id/btn_month_prev"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/calendar_prev_month"
                            android:padding="8dp"
                            android:src="@drawable/baseline_chevron_left_24"
                            app:tint="@color/text_secondary" />

                        <TextView
                            android:id="@+id/tv_month_label"
                            style="@style/Text.Title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            tools:text="2026년 10월" />

                        <ImageView
                            android:id="@+id/btn_month_next"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/calendar_next_month"
                            android:padding="8dp"
                            android:src="@drawable/baseline_chevron_right_24"
                            app:tint="@color/text_secondary" />
                    </LinearLayout>

                    <com.youngs.picview.ui.calendar.MonthGridView
                        android:id="@+id/view_month_grid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_s" />

                    <!-- 범례 : 절정(단풍) · 추천(황금) -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="@dimen/space_s"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:contentDescription="@null"
                            android:src="@drawable/dot_indicator_active"
                            app:tint="@color/maple_500" />

                        <TextView
                            style="@style/Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="@string/calendar_legend_peak" />

                        <ImageView
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:layout_marginStart="@dimen/space_l"
                            android:contentDescription="@null"
                            android:src="@drawable/dot_indicator_active"
                            app:tint="@color/golden_500" />

                        <TextView
                            style="@style/Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="@string/calendar_legend_reco" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ─────────── 지금 갈 곳 ─────────── -->
            <TextView
                android:id="@+id/tv_now_go"
                style="@style/Text.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_padding"
                android:layout_marginTop="@dimen/space_2xl"
                tools:text="🌿 지금 갈 곳" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_calendar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:nestedScrollingEnabled="false"
                android:paddingHorizontal="@dimen/screen_padding"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="2"
                tools:listitem="@layout/item_season_highlight" />

            <!-- 관광공사 등록 축제 (있을 때만) -->
            <TextView
                android:id="@+id/tv_festival_header"
                style="@style/Text.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_padding"
                android:layout_marginTop="@dimen/space_2xl"
                android:text="@string/calendar_festivals"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tv_festival_list"
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/screen_padding"
                android:layout_marginTop="@dimen/space_s"
                android:visibility="gone"
                tools:text="정읍사문화제 · 10월 25일 ~ 26일"
                tools:visibility="visible" />

            <TextView
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/screen_padding"
                android:layout_marginTop="@dimen/space_2xl"
                android:text="@string/calendar_disclaimer" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
