<?xml version="1.0" encoding="utf-8"?>
<!-- 오늘의 빛 스케줄 결과. 상단 요약 + 타임라인. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page">

    <!-- ── 상단 바 ── -->
    <LinearLayout
        android:id="@+id/layout_result_top"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_m"
        android:paddingVertical="@dimen/space_s"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btn_result_back"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/text_primary" />

        <TextView
            android:id="@+id/tv_result_title"
            style="@style/Text.SectionTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xs"
            android:layout_weight="1"
            android:text="@string/course_result_title" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_result_save"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/course_save"
            android:textColor="@color/maple_600" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_3xl"
        app:layout_constraintTop_toBottomOf="@id/layout_result_top"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!--
              ── 오늘의 코스 요약 ──

              예전에는 단풍색 한 덩어리 안에 세 줄이 같은 무게로 쌓여
              무엇이 제목이고 무엇이 수치인지 읽히지 않았고, 날짜가
              어디에도 없어 "언제의 코스인지"를 모른 채 보게 됐습니다.

              지금은 세 층입니다 — 날짜(언제) → 한 줄 설명(왜 이 순서) →
              숫자 세 칸(몇 곳·얼마·얼마나 멀리). 일출·일몰은 이모지 대신
              아이콘을 달고 좌우 두 칸으로 나눕니다.
            -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/screen_padding"
                android:layout_marginBottom="@dimen/space_xl"
                app:cardBackgroundColor="@color/maple_500"
                app:cardCornerRadius="@dimen/radius_card"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_l">

                    <!--
                      날짜·출발 시각은 결과를 보고 나서 고치고 싶어집니다 —
                      "한 시간 늦게 나갈걸", "이건 내일 하자". 그때마다 입력
                      화면으로 되돌아가 동행·체류·이동·목적을 다시 고르게
                      하면 아무도 고치지 않습니다. 여기서 바로 누릅니다.
                    -->
                    <TextView
                        android:id="@+id/tv_result_date"
                        style="@style/Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill_dark"
                        android:drawablePadding="6dp"
                        android:gravity="center_vertical"
                        android:letterSpacing="0.02"
                        android:minHeight="32dp"
                        android:paddingHorizontal="@dimen/space_m"
                        android:paddingVertical="4dp"
                        android:textColor="@color/white"
                        app:drawableStartCompat="@drawable/ic_calendar"
                        app:drawableEndCompat="@drawable/baseline_chevron_right_24"
                        app:drawableTint="#B3FFFFFF"
                        tools:text="2026.08.27 (목) · 09:09 출발" />

                    <TextView
                        android:id="@+id/tv_result_narration"
                        style="@style/Text.Title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:textColor="@color/white"
                        tools:text="내장산의 일몰 골든아워에 맞춰 동선을 짰어요." />

                    <!-- 일출·일몰 — 하루의 양 끝이라 좌우로 맞붙입니다. -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_m"
                        android:background="@drawable/bg_pill_dark"
                        android:baselineAligned="false"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/space_m"
                        android:paddingVertical="@dimen/space_s">

                        <TextView
                            android:id="@+id/tv_result_sunrise"
                            style="@style/Text.Caption"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:drawablePadding="6dp"
                            android:gravity="center_vertical"
                            android:textColor="@color/white"
                            app:drawableStartCompat="@drawable/ic_sunrise_line"
                            app:drawableTint="@color/golden_300"
                            tools:text="일출 06:00" />

                        <View
                            android:layout_width="1dp"
                            android:layout_height="16dp"
                            android:layout_gravity="center_vertical"
                            android:layout_marginHorizontal="@dimen/space_m"
                            android:background="#33FFFFFF" />

                        <TextView
                            android:id="@+id/tv_result_sunset"
                            style="@style/Text.Caption"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:drawablePadding="6dp"
                            android:gravity="center_vertical"
                            android:textColor="@color/white"
                            app:drawableStartCompat="@drawable/ic_sunset_line"
                            app:drawableTint="@color/golden_300"
                            tools:text="일몰 19:09" />
                    </LinearLayout>

                    <!-- 숫자 세 칸. 값을 크게, 라벨을 아래 작게 둡니다. -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_l"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_result_stat_count"
                                style="@style/Text.SectionTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/white"
                                tools:text="3곳" />

                            <TextView
                                style="@style/Text.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/course_stat_places"
                                android:textColor="#99FFFFFF"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_result_stat_time"
                                style="@style/Text.SectionTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/white"
                                tools:text="2시간 54분" />

                            <TextView
                                style="@style/Text.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/course_stat_duration"
                                android:textColor="#99FFFFFF"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_result_stat_distance"
                                style="@style/Text.SectionTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/white"
                                tools:text="3km" />

                            <TextView
                                style="@style/Text.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/course_stat_distance"
                                android:textColor="#99FFFFFF"
                                android:textSize="10sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/Text.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_padding"
                android:layout_marginBottom="@dimen/space_m"
                android:text="@string/course_timeline" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_course_stops"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:itemCount="4"
                tools:listitem="@layout/item_course_stop" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progress_result"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="@color/maple_500"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>
