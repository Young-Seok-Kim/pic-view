<?xml version="1.0" encoding="utf-8"?>
<!-- 시즌 촬영 적기 한 건. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_m"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/bg_card"
    app:cardCornerRadius="@dimen/radius_card"
    app:cardElevation="0dp"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_l">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_season_emoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="22sp"
                tools:text="🍁" />

            <TextView
                android:id="@+id/tv_season_title"
                style="@style/Text.SectionTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_s"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="내장산 단풍" />

            <TextView
                android:id="@+id/tv_season_dday"
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_score_chip"
                android:paddingHorizontal="@dimen/space_s"
                android:paddingVertical="2dp"
                android:textColor="@color/score_chip_text"
                android:textStyle="bold"
                tools:text="D-85" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_season_period"
            style="@style/Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            tools:text="10월 28일 ~ 11월 15일 · 단풍터널" />

        <TextView
            android:id="@+id/tv_season_tip"
            style="@style/Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            tools:text="대한민국 단풍 1번지. 단풍터널은 역광이 살아나는 늦은 오후가 절정입니다." />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
