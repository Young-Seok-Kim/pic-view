<?xml version="1.0" encoding="utf-8"?>
<!--
  정읍의 순간을 담다 (포토 프레임 시안).
  배경을 어둡게 둬야 폴라로이드의 밝은 종이가 떠 보입니다.
  네컷 사진 / 사진 프레임 두 모드를 위 토글로 오갑니다.
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_frame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/frame_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/space_2xl">

        <!-- ─────────── 상단 바 ─────────── -->
        <LinearLayout
            android:id="@+id/layout_frame_top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/screen_padding"
            android:paddingTop="@dimen/space_m">

            <ImageView
                android:id="@+id/btn_frame_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_glass_circle"
                android:contentDescription="@string/cd_back"
                android:padding="9dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/white" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_m"
                android:layout_weight="1"
                android:text="@string/frame_title"
                android:textAppearance="@style/Text.Title"
                android:textColor="@color/white" />

            <!--
              색감 필터로 가는 문. 프레임을 고르기 전에 색을 정하는 순서가
              자연스럽습니다. 네컷 모드에서는 숨깁니다(한 장짜리 필터라서).
            -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_frame_color"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_xs"
                android:minWidth="0dp"
                android:paddingHorizontal="@dimen/space_m"
                android:text="@string/frame_color"
                android:textColor="@color/white" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_frame_save"
                style="@style/Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:paddingHorizontal="@dimen/space_l"
                android:text="@string/frame_save" />
        </LinearLayout>

        <!-- ─────────── 미리보기 ─────────── -->
        <!--
          미리보기 카드. 시안처럼 주황 테두리가 어두운 배경에서 종이를 받쳐 줍니다.
          만들어지는 그림 비율이 모드마다 달라(1:1 · 3:5) adjustViewBounds 로 따라갑니다.
        -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:layout_marginHorizontal="@dimen/space_2xl"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/maple_400"
            app:strokeWidth="2dp">

            <ImageView
                android:id="@+id/iv_frame_preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:contentDescription="@string/cd_frame_preview"
                tools:src="@drawable/bg_image_placeholder" />
        </com.google.android.material.card.MaterialCardView>

        <!-- ─────────── 모드 토글 ─────────── -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggle_frame_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:layout_marginHorizontal="@dimen/screen_padding"
            app:checkedButton="@id/btn_mode_single"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_mode_fourcut"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/frame_mode_fourcut"
                android:textColor="@color/white"
                app:strokeColor="#66FFFFFF" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_mode_single"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/frame_mode_single"
                android:textColor="@color/white"
                app:strokeColor="#66FFFFFF" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- ─────────── 프레임 선택 ─────────── -->
        <TextView
            style="@style/Text.SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:layout_marginHorizontal="@dimen/screen_padding"
            android:text="@string/frame_pick"
            android:textColor="@color/white" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_frames"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/screen_padding"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:itemCount="4"
            tools:listitem="@layout/item_frame_swatch" />

        <!-- ─────────── 사진 선택 · 공유 ─────────── -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_frame_pick"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:layout_marginHorizontal="@dimen/screen_padding"
            android:fontFamily="@font/mapo_backpacking"
            android:minHeight="52dp"
            android:text="@string/frame_pick_one"
            android:textColor="@color/white"
            android:textSize="@dimen/text_button"
            app:cornerRadius="@dimen/radius_button"
            app:strokeColor="#66FFFFFF" />

        <!-- 보이는 부분 조정 — 창과 사진 비율이 달라 잘리는 부분을 사람이 정합니다. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_frame_adjust"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:layout_marginHorizontal="@dimen/screen_padding"
            android:fontFamily="@font/mapo_backpacking"
            android:minHeight="52dp"
            android:text="@string/frame_adjust"
            android:textColor="@color/white"
            android:textSize="@dimen/text_button"
            app:cornerRadius="@dimen/radius_button"
            app:strokeColor="#66FFFFFF" />

        <!-- 장소 이름 — 손그림 폴라로이드(장소명이 찍히는 프레임)에서만 보입니다. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_frame_place"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:layout_marginHorizontal="@dimen/screen_padding"
            android:fontFamily="@font/mapo_backpacking"
            android:minHeight="52dp"
            android:text="@string/frame_edit_place"
            android:textColor="@color/white"
            android:textSize="@dimen/text_button"
            app:cornerRadius="@dimen/radius_button"
            app:strokeColor="#66FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_frame_share"
            style="@style/Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:layout_marginHorizontal="@dimen/screen_padding"
            android:minHeight="52dp"
            android:text="@string/frame_share" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
