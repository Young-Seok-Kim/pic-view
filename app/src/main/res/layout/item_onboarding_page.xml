<?xml version="1.0" encoding="utf-8"?>
<!--
    온보딩 한 장 — 빛 장면 카드 + 제목 + 설명 (시안 결).
    이모지 원 대신 계획 탭 히어로와 같은 붓(빛 장면 그림)을 씁니다.
    첫 화면부터 앱이 쓰는 그림 언어를 미리 보여 주는 셈입니다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/space_3xl">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="176dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/maple_200"
        app:strokeWidth="1.5dp">

        <ImageView
            android:id="@+id/iv_onboarding_scene"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            tools:src="@drawable/bg_hero_sunset" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tv_onboarding_eyebrow"
        style="@style/Text.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2xl"
        android:letterSpacing="0.14"
        android:textColor="@color/maple_600"
        android:textSize="11sp"
        android:textStyle="bold"
        tools:text="LIGHT MATCH" />

    <TextView
        android:id="@+id/tv_onboarding_title"
        style="@style/Text.Display"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:gravity="center"
        tools:text="지금, 가장 잘 나오는 곳" />

    <TextView
        android:id="@+id/tv_onboarding_desc"
        style="@style/Text.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_m"
        android:gravity="center"
        android:lineSpacingExtra="6dp"
        tools:text="날씨와 해의 위치를 실시간으로 계산해 지금 사진이 가장 잘 나오는 촬영지를 점수로 알려드려요." />

</LinearLayout>
