<?xml version="1.0" encoding="utf-8"?>
<!--
  촬영 화면의 포즈 카드.

  카메라 미리보기를 최대한 가리지 않아야 하므로 세로로 쌓지 않고
  한 줄로 눕혔습니다. 이모지·점수·이름이 한 높이에 들어옵니다.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_pose"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/pose_card_bg"
    app:cardCornerRadius="@dimen/radius_pill"
    app:cardElevation="0dp"
    app:strokeColor="@color/pose_card_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_m"
        android:paddingVertical="@dimen/space_s">

        <TextView
            android:id="@+id/tv_pose_emoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            tools:text="🚶" />

        <TextView
            android:id="@+id/tv_pose_label"
            style="@style/Text.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_s"
            android:maxLines="1"
            android:textColor="@color/pose_card_text"
            android:textStyle="bold"
            tools:text="뒤돌아 걷기" />

        <TextView
            android:id="@+id/tv_pose_score"
            style="@style/Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_s"
            android:background="@drawable/bg_pose_score"
            android:paddingHorizontal="7dp"
            android:paddingVertical="1dp"
            android:textColor="@color/score_chip_text"
            android:textStyle="bold"
            tools:text="92" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
