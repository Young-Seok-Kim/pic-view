<?xml version="1.0" encoding="utf-8"?>
<!--
  실전 촬영 미션 (시선 가이드).

  체크 셋 + 세 위치의 사진 셋이 다 모여야 완료 버튼이 켜집니다.
  같은 장면을 세 번 움직여 비교하는 것 자체가 미션입니다.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_page">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_l">

        <!-- 헤더 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_mission_header"
                style="@style/Text.Caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:letterSpacing="0.12"
                android:textColor="@color/maple_600"
                android:textSize="10sp"
                tools:text="FIELD MISSION · 반사" />

            <ImageView
                android:id="@+id/btn_mission_close"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_back"
                android:padding="6dp"
                android:src="@drawable/baseline_close_24"
                app:tint="@color/text_secondary" />
        </LinearLayout>

        <!-- 지금 상황 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            app:cardBackgroundColor="@color/live_weather_bg"
            app:cardCornerRadius="@dimen/radius_card"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_l">

                <TextView
                    android:id="@+id/tv_mission_ctx_label"
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.12"
                    android:textColor="@color/live_weather_eyebrow"
                    android:textSize="10sp"
                    tools:text="GOLDEN HOUR" />

                <TextView
                    android:id="@+id/tv_mission_ctx_title"
                    style="@style/Text.SectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    tools:text="노을빛이 닿는 곳을 담아보세요" />

                <TextView
                    android:id="@+id/tv_mission_goal"
                    style="@style/Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:textColor="#E6FFFFFF"
                    tools:text="지붕선·수면·나뭇가지에 닿은 따뜻한 빛을 따라 이동해보세요." />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!--
          미션 음성으로 듣기.

          현장에서 해가 넘어가는 동안 손은 카메라에 있고 눈은 장면에
          있습니다. 그때 읽으라고 하면 아무도 읽지 않아서, 같은 문장을
          귀로도 받게 합니다.

          처음에는 아래 "현장에서 이렇게 해보세요" 줄의 진행도(1/3) 옆에
          아이콘만 붙였는데, 진행도의 일부처럼 보이고 눌리는 것인지도
          알 수 없었습니다. 읽어 줄 글(위 상황 카드) 바로 아래로 내리고
          글자를 붙여, 무엇을 읽어 주는 버튼인지가 자리로 드러나게 했습니다.
        -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_mission_tts"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:minHeight="40dp"
            android:paddingHorizontal="@dimen/space_m"
            android:text="@string/mission_listen"
            android:textColor="@color/maple_700"
            android:textSize="@dimen/text_caption"
            app:cornerRadius="@dimen/radius_button"
            app:icon="@drawable/ic_audio"
            app:iconSize="16dp"
            app:iconTint="@color/maple_600"
            app:strokeColor="@color/maple_300" />

        <!-- 현장 체크 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/Text.SectionTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/mission_steps_title" />

            <TextView
                android:id="@+id/tv_mission_check_count"
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/maple_600"
                tools:text="1/3" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_mission_steps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:orientation="vertical" />

        <!-- 세 장 비교 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/Text.SectionTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/mission_capture_title" />

            <TextView
                android:id="@+id/tv_mission_photo_count"
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/maple_600"
                tools:text="0/3 추가됨" />
        </LinearLayout>

        <TextView
            style="@style/Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@string/mission_capture_sub"
            android:textColor="@color/text_secondary" />

        <LinearLayout
            android:id="@+id/layout_mission_slots"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:baselineAligned="false"
            android:orientation="horizontal" />

        <!-- 자동 분석 -->
        <LinearLayout
            android:id="@+id/layout_mission_feedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Text.SectionTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/mission_feedback_title" />

                <TextView
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mission_feedback_auto"
                    android:textColor="@color/text_tertiary" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_mission_feedback"
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:background="@drawable/bg_detail_note"
                android:lineSpacingExtra="4dp"
                android:padding="@dimen/space_m"
                tools:text="01 화면의 밝기 중심이 오른쪽으로 이동했어요." />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_mission_complete"
            style="@style/Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="@dimen/space_l"
            android:enabled="false"
            android:text="@string/mission_incomplete"
            app:backgroundTint="@color/maple_500" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
