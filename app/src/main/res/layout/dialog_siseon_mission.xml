<?xml version="1.0" encoding="utf-8"?>
<!--
  실전 촬영 미션 (시선 가이드).

  체크 셋 + 세 위치의 사진 셋이 다 모여야 완료 버튼이 켜집니다.
  같은 장면을 세 번 움직여 비교하는 것 자체가 미션입니다.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_page">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_l">

        <!-- 헤더 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_mission_header"
                style="@style/Text.Caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:letterSpacing="0.12"
                android:textColor="@color/maple_600"
                android:textSize="10sp"
                tools:text="FIELD MISSION · 반사" />

            <ImageView
                android:id="@+id/btn_mission_close"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_back"
                android:padding="6dp"
                android:src="@drawable/baseline_close_24"
                app:tint="@color/text_secondary" />
        </LinearLayout>

        <!-- 지금 상황 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            app:cardBackgroundColor="@color/live_weather_bg"
            app:cardCornerRadius="@dimen/radius_card"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_l">

                <TextView
                    android:id="@+id/tv_mission_ctx_label"
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.12"
                    android:textColor="@color/live_weather_eyebrow"
                    android:textSize="10sp"
                    tools:text="GOLDEN HOUR" />

                <TextView
                    android:id="@+id/tv_mission_ctx_title"
                    style="@style/Text.SectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    tools:text="노을빛이 닿는 곳을 담아보세요" />

                <TextView
                    android:id="@+id/tv_mission_goal"
                    style="@style/Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:textColor="#E6FFFFFF"
                    tools:text="지붕선·수면·나뭇가지에 닿은 따뜻한 빛을 따라 이동해보세요." />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 현장 체크 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/Text.SectionTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/mission_steps_title" />

            <TextView
                android:id="@+id/tv_mission_check_count"
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/maple_600"
                tools:text="1/3" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_mission_steps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:orientation="vertical" />

        <!-- 세 장 비교 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/Text.SectionTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/mission_capture_title" />

            <TextView
                android:id="@+id/tv_mission_photo_count"
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/maple_600"
                tools:text="0/3 추가됨" />
        </LinearLayout>

        <TextView
            style="@style/Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@string/mission_capture_sub"
            android:textColor="@color/text_secondary" />

        <LinearLayout
            android:id="@+id/layout_mission_slots"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:baselineAligned="false"
            android:orientation="horizontal" />

        <!-- 자동 분석 -->
        <LinearLayout
            android:id="@+id/layout_mission_feedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Text.SectionTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/mission_feedback_title" />

                <TextView
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mission_feedback_auto"
                    android:textColor="@color/text_tertiary" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_mission_feedback"
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:background="@drawable/bg_detail_note"
                android:lineSpacingExtra="4dp"
                android:padding="@dimen/space_m"
                tools:text="01 화면의 밝기 중심이 오른쪽으로 이동했어요." />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_mission_complete"
            style="@style/Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="@dimen/space_l"
            android:enabled="false"
            android:text="@string/mission_incomplete"
            app:backgroundTint="@color/maple_500" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
