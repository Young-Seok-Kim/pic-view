<?xml version="1.0" encoding="utf-8"?>
<!--
    홈 상단의 기온 줄.

    전에는 기온·빛 상태·촬영지 수를 작은 카드 셋으로 나눠 놨습니다. 그런데
    빛 상태는 바로 위 히어로 카드가 이미 큰 글씨로 말하고 있었고, 촬영지
    수(85)는 바뀌지 않는 숫자라 매일 같은 자리를 차지만 했습니다. 하나만
    남기고 폭을 다 주니 기온에 체감·습도를 함께 붙일 자리가 생겼습니다.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/bg_card"
    app:cardCornerRadius="@dimen/radius_card"
    app:cardElevation="0dp"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_l"
        android:paddingVertical="@dimen/space_m">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/home_temp_icon"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/tv_weather_temp"
            style="@style/Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_m"
            tools:text="24℃" />

        <!-- 체감·습도는 보조 정보라 오른쪽 끝으로 밀어 기온과 시선을 나눕니다. -->
        <TextView
            android:id="@+id/tv_weather_detail"
            style="@style/Text.Caption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="end"
            android:maxLines="1"
            tools:text="체감 25℃   습도 58%" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
