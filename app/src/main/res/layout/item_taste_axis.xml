<?xml version="1.0" encoding="utf-8"?>
<!--
    촬영 성향 한 축 — 아이콘 · 이름 · 막대 · 백분율.

    좁은 카드 안이라 이름은 고정폭을 줍니다. "반영"과 "수변"의 폭이 달라
    막대 시작점이 어긋나면 세 줄이 나란해 보이지 않습니다.

    루트를 <merge> 로 두면 ViewBinding 이 include 용 바인딩을 만들지 않아
    코드에서 축 세 개를 각각 잡을 수 없습니다. LinearLayout 을 유지합니다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/iv_axis_icon"
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:contentDescription="@null"
        app:tint="@color/maple_500"
        tools:src="@drawable/ic_sun" />

    <TextView
        android:id="@+id/tv_axis_label"
        style="@style/Text.Caption"
        android:layout_width="34dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:textColor="@color/text_primary"
        tools:text="반영" />

    <ProgressBar
        android:id="@+id/progress_axis"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="0dp"
        android:layout_height="7dp"
        android:layout_marginHorizontal="6dp"
        android:layout_weight="1"
        android:max="100"
        android:progressDrawable="@drawable/bg_taste_bar"
        tools:progress="68" />

    <TextView
        android:id="@+id/tv_axis_percent"
        style="@style/Text.Caption"
        android:layout_width="32dp"
        android:layout_height="wrap_content"
        android:fontFeatureSettings="tnum"
        android:gravity="end"
        android:textColor="@color/text_secondary"
        tools:text="68%" />
</LinearLayout>
