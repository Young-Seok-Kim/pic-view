<?xml version="1.0" encoding="utf-8"?>
<!--
  탐색 '빛이 맞는 출사' 카드.

  예전에는 빛 신호·이름·이유·구도·거리·CTA 버튼이 전부 같은 크기의
  글줄로 쌓여 있어 무엇을 먼저 봐야 할지 알 수 없었습니다. 위계를
  세 단으로 다시 잡았습니다.

    1단  사진 위 뱃지  — "언제 · 어떤 빛" 은 사진 위에서 읽힙니다
    2단  장소명(크게) + 이유(작게)
    3단  구도·거리를 아이콘 한 줄로

  버튼 하나가 카드 폭의 1/3을 먹던 자리를 없애고 카드 전체를 탭 영역으로
  넓혔습니다. 손가락이 큰 과녁을 찾아가는 편이 언제나 빠릅니다.

  찜(하트)과 카메라는 장소명 줄 오른쪽에 둡니다. 거리 줄에 두었을 때는
  "내 위치에서 차로 6시간 20분"처럼 긴 문구가 아이콘에 밀려 잘렸습니다.
  장소명이 길면 줄임표 대신 흐르게(marquee) 해서 아이콘 자리를 내주고도
  이름을 다 보입니다.

  카메라는 그 장소의 **촬영 시작**(앱 카메라, 상세의 촬영 시작과 같은 곳)
  입니다. 예전에는 "한 장을 더 잘 찍는 순서" 가이드를 열었는데, 어느 카드를
  눌러도 같은 화면이라 카드마다 둘 이유가 없었고 홈에 공통 진입점이 있습니다.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/screen_padding"
    android:layout_marginVertical="7dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/bg_card"
    app:cardCornerRadius="@dimen/radius_card"
    app:cardElevation="0dp"
    app:rippleColor="#22000000"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="164dp">

            <ImageView
                android:id="@+id/iv_spot_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/bg_image_placeholder"
                android:contentDescription="@string/cd_spot_thumbnail"
                android:scaleType="centerCrop"
                tools:src="@tools:sample/backgrounds/scenic" />

            <!--
              사진 아래쪽을 살짝 어둡게 눌러 뱃지 글자가 어떤 사진 위에서도
              읽히게 합니다. 사진 전체를 덮지 않아 실사진의 색은 남습니다.
            -->
            <View
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_gravity="bottom"
                android:background="@drawable/bg_photo_scrim" />

            <!-- 빛 신호 — 이 장소의 빛이 지금 어떤 얼굴인지 한 마디. -->
            <TextView
                android:id="@+id/tv_spot_signal"
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="@dimen/space_m"
                android:background="@drawable/bg_signal_badge"
                android:paddingHorizontal="@dimen/space_m"
                android:paddingVertical="5dp"
                android:textColor="@color/white"
                android:textStyle="bold"
                tools:text="일몰 · 따뜻한 사광" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_l"
            android:paddingTop="@dimen/space_m"
            android:paddingBottom="@dimen/space_l">

            <!-- 장소명 + 찜. 이름이 길면 잘리지 않고 흐릅니다(어댑터가 isSelected 를 켭니다). -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_spot_title"
                    style="@style/Text.Title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="marquee"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:scrollHorizontally="true"
                    android:singleLine="true"
                    tools:text="내장산 국립공원" />

                <ImageView
                    android:id="@+id/btn_spot_favorite"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="@dimen/space_s"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cd_favorite"
                    android:padding="9dp"
                    android:src="@drawable/ic_heart"
                    app:tint="@color/maple_500" />

                <ImageView
                    android:id="@+id/btn_spot_shoot"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="-9dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/action_shoot_start"
                    android:padding="9dp"
                    android:src="@drawable/baseline_camera_alt_24"
                    app:tint="@color/maple_500" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_spot_reason"
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/text_secondary"
                tools:text="단풍터널은 역광이 살아나는 늦은 오후가 절정이에요" />

            <!--
              구도와 거리는 사실 정보라 한 줄로 눕힙니다. 두 줄로 세워 두면
              장소명과 같은 무게로 읽혀 위계가 무너집니다.
            -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_spot_guide_line"
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawablePadding="4dp"
                    android:gravity="center_vertical"
                    android:textColor="@color/text_secondary"
                    app:drawableStartCompat="@drawable/ic_composition_grid"
                    app:drawableTint="@color/text_tertiary"
                    tools:text="레이어드" />

                <TextView
                    android:id="@+id/tv_spot_travel"
                    style="@style/Text.Caption"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_m"
                    android:layout_weight="1"
                    android:drawablePadding="4dp"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:textColor="@color/text_secondary"
                    app:drawableStartCompat="@drawable/ic_car"
                    app:drawableTint="@color/text_tertiary"
                    tools:text="내 위치에서 차로 25분" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
