<?xml version="1.0" encoding="utf-8"?>
<!--
  홈의 빠른 이동 타일.

  색 사각형 + 이모지였던 것을 그림 + 설명으로 바꿨습니다. 이모지는 기기마다
  다르게 그려지고, 라벨 한 낱말만으로는 "캘린더에 뭐가 있는지"가 안 보였습니다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <!--
      높이는 코드가 정합니다 (HomeFragment.buildQuickActions) — 화면 폭에서
      여백과 칸 사이 간격을 뺀 뒤 넷으로 나눈 값이라 타일이 정사각형이
      됩니다. 예전에는 여기에 0dp 를 두었는데, 가중치 없는 세로 방향에서
      0dp 는 "보이지 않는 뷰"라 lint 가 Suspicious0dp 로 막았습니다.
      값이 어차피 덮어씌워지므로 wrap_content 로 두고, 미리보기 높이만
      tools 로 넣어 둡니다. adjustViewBounds 는 centerCrop 과 함께 쓰면
      아무 일도 하지 않아 함께 뺐습니다.
    -->
    <ImageView
        android:id="@+id/iv_qa_icon"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_quick_action"
        android:clickable="true"
        android:contentDescription="@null"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:scaleType="centerCrop"
        tools:layout_height="78dp"
        tools:src="@drawable/qa_map" />

    <TextView
        android:id="@+id/tv_qa_label"
        style="@style/Text.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/text_primary"
        android:textStyle="bold"
        tools:text="지도" />

    <!--
      두 줄 설명. 라벨만으로는 무엇을 하는 곳인지 알기 어렵습니다.
      네 칸이 나란히 서므로 줄 수를 2로 고정해 타일 높이를 맞춥니다.
    -->
    <TextView
        android:id="@+id/tv_qa_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:lineSpacingExtra="1dp"
        android:lines="2"
        android:textColor="@color/text_tertiary"
        android:textSize="10sp"
        tools:text="명소, 포토존,\n맛집 위치를 한눈에" />
</LinearLayout>
