<?xml version="1.0" encoding="utf-8"?>
<!--
    온보딩 3장 : YOUR SISEON (시안 3번 화면).
    구도 가이드 예시 사진을 테두리 없이 가득 깔고 위아래를 배경색으로
    녹입니다. 실루엣·반영·리딩라인 썸네일을 보여 준 뒤, 화면 아래
    (액티비티)의 모드 버튼으로 보기 방식을 고릅니다.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingVertical="@dimen/space_l">

        <TextView
            style="@style/Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.14"
            android:text="@string/onboarding_3_eyebrow"
            android:textColor="@color/maple_600"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            style="@style/Text.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:gravity="center"
            android:paddingHorizontal="@dimen/space_3xl"
            android:text="@string/onboarding_3_title" />

        <TextView
            style="@style/Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:gravity="center"
            android:lineSpacingExtra="6dp"
            android:paddingHorizontal="@dimen/space_3xl"
            android:text="@string/onboarding_3_desc" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/onb_siseon" />

            <View
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_gravity="top"
                android:background="@drawable/bg_onboarding_fade_top" />

            <View
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_gravity="bottom"
                android:background="@drawable/bg_onboarding_fade_bottom" />
        </FrameLayout>

        <!-- 구도 가이드 맛보기 : 실루엣 · 반영 · 리딩라인 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/space_2xl">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="76dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/onboarding_demo_guide_silhouette"
                        android:scaleType="centerCrop"
                        android:src="@drawable/guide_silhouette" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="@string/onboarding_demo_guide_silhouette"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/space_s"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="76dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/onboarding_demo_guide_reflection"
                        android:scaleType="centerCrop"
                        android:src="@drawable/onb_reflection" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="@string/onboarding_demo_guide_reflection"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="76dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/onboarding_demo_guide_leading"
                        android:scaleType="centerCrop"
                        android:src="@drawable/guide_leading" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="@string/onboarding_demo_guide_leading"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:paddingHorizontal="@dimen/space_3xl"
            android:text="@string/onboarding_3_note"
            android:textColor="@color/text_tertiary" />
    </LinearLayout>
</ScrollView>
