<?xml version="1.0" encoding="utf-8"?>
<!--
    계획(출사 조건 입력) — 빛 코스 시안.

    위에서부터 : 로고+날짜 알약 → "지금, 정읍의 빛" 히어로 →
    조건 카드 다섯 칸 → 오늘의 빛 코스 미리보기 → 빛 타임라인 → CTA 둘.
    히어로 배경은 지금 빛 구간(일출·낮·석양·블루아워·밤)을 따라 코드가 바꿉니다.
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scroll_course_input"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/space_3xl">

        <!-- ─────────── 로고 · 날짜 ─────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:layout_marginHorizontal="@dimen/screen_padding"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/Text.Display"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textColor="@color/maple_500"
                android:textSize="24sp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_course_date"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="21dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/space_l"
                    android:paddingEnd="@dimen/space_s">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_calendar"
                        app:tint="@color/maple_500" />

                    <TextView
                        android:id="@+id/tv_course_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_s"
                        android:fontFamily="@font/pretendard_semibold"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_body"
                        tools:text="2026.08.12 (수)" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="2dp"
                        android:contentDescription="@string/course_date_change"
                        android:src="@drawable/baseline_chevron_right_24"
                        app:tint="@color/text_tertiary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- ─────────── 히어로 : 지금, 정읍의 빛 ─────────── -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_hero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:layout_marginHorizontal="@dimen/screen_padding"
            app:cardCornerRadius="@dimen/radius_card"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/iv_hero"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitXY"
                    tools:src="@drawable/bg_hero_sunset" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_xl">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_hero_dot"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="●"
                            android:textColor="@color/maple_500"
                            android:textSize="8sp" />

                        <TextView
                            android:id="@+id/tv_hero_eyebrow"
                            style="@style/Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_s"
                            android:text="@string/course_hero_eyebrow"
                            android:textColor="@color/text_secondary" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_hero_headline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:fontFamily="@font/pretendard_bold"
                        android:letterSpacing="-0.02"
                        android:textColor="@color/text_primary"
                        android:textSize="30sp"
                        tools:text="석양까지 58분" />

                    <TextView
                        android:id="@+id/tv_hero_golden"
                        style="@style/Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_m"
                        android:textColor="@color/text_secondary"
                        tools:text="오늘 골든아워 18:40 ~ 19:20 ⓘ" />
                </LinearLayout>
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <!--
          ─────────── 저장한 코스 ───────────
          저장한 코스가 있으면 히어로 바로 아래에 나옵니다. 코스를 세워 둔
          사람이 이 탭을 여는 이유는 새 계획이 아니라 그 계획이라서입니다.
          오늘 예정 코스는 따로 크게 강조합니다.
        -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_today_plan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:layout_marginHorizontal="@dimen/screen_padding"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            app:cardBackgroundColor="@color/maple_50"
            app:cardCornerRadius="@dimen/radius_card"
            app:cardElevation="0dp"
            app:strokeColor="@color/maple_200"
            app:strokeWidth="1dp"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_l">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Text.Caption"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/course_today_plan"
                        android:textColor="@color/maple_600"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/course_today_open"
                        android:textColor="@color/maple_600"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_today_title"
                    style="@style/Text.SectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:ellipsize="end"
                    android:maxLines="1"
                    tools:text="내장산국립공원 외 4곳" />

                <TextView
                    android:id="@+id/tv_today_line"
                    style="@style/Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/text_secondary"
                    tools:text="18:10 내장산국립공원부터 · 5곳" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/row_saved_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2xl"
            android:layout_marginHorizontal="@dimen/screen_padding"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/pretendard_bold"
                android:text="@string/course_saved_section"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_section" />

            <TextView
                android:id="@+id/btn_saved_all"
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="@dimen/space_xs"
                android:text="@string/home_see_all"
                android:textColor="@color/maple_600"
                android:textStyle="bold" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_saved_courses"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:layout_marginHorizontal="@dimen/screen_padding"
            android:nestedScrollingEnabled="false"
            android:visibility="gone"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:itemCount="2"
            tools:listitem="@layout/item_saved_course"
            tools:visibility="visible" />

        <!-- ─────────── 조건 선택 ─────────── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2xl"
            android:layout_marginHorizontal="@dimen/screen_padding"
            android:fontFamily="@font/pretendard_bold"
            android:text="@string/course_pick_title"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_section" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/screen_padding"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/layout_conditions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:layout_marginHorizontal="@dimen/screen_padding"
            android:text="@string/course_pick_hint"
            android:textColor="@color/text_tertiary"
            android:textSize="@dimen/text_caption" />

        <!--
          ─────────── 직접 고르기 ───────────

          "장소는 내가, 순서는 빛이." 코스를 앱이 전부 짜 주기만 하면
          "나는 여기랑 여기만 갈래"가 안 되고, 찜을 해 둬도 그 찜한 곳으로
          코스를 만들 수가 없습니다. 고르는 일만 돌려주고 세우는 일은
          그대로 빛이 합니다.
        -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_pick_spots"
            style="@style/Card.Elevated"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:layout_marginHorizontal="@dimen/screen_padding"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/space_m">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_place"
                    app:tint="@color/maple_500" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_m"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/picker_entry_title" />

                    <TextView
                        android:id="@+id/tv_pick_summary"
                        style="@style/Text.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/text_secondary"
                        tools:text="3곳을 담았어요 · 순서는 빛이 정합니다" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/baseline_chevron_right_24"
                    app:tint="@color/text_tertiary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ─────────── 오늘의 빛 코스 ─────────── -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Card.Elevated"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:layout_marginHorizontal="@dimen/screen_padding">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_l">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Text.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/course_today_title" />

                    <TextView
                        android:id="@+id/tv_reco_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_s"
                        android:background="@drawable/bg_pill_outline"
                        android:paddingHorizontal="@dimen/space_m"
                        android:paddingVertical="3dp"
                        android:text="@string/course_reco_badge"
                        android:textColor="@color/maple_600"
                        android:textSize="@dimen/text_caption" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tv_other_course"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill_soft"
                        android:paddingHorizontal="@dimen/space_m"
                        android:paddingVertical="5dp"
                        android:text="@string/course_other"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_course_preview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:orientation="horizontal"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:itemCount="1"
                    tools:listitem="@layout/item_course_preview" />

                <TextView
                    android:id="@+id/tv_course_empty"
                    style="@style/Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingVertical="@dimen/space_2xl"
                    android:text="@string/course_preview_empty"
                    android:visibility="gone"
                    tools:visibility="gone" />

                <LinearLayout
                    android:id="@+id/layout_course_dots"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:gravity="center"
                    android:orientation="horizontal" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ─────────── 오늘의 빛 타임라인 ─────────── -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Card.Elevated"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:layout_marginHorizontal="@dimen/screen_padding">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_l">

                <TextView
                    style="@style/Text.SectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/course_timeline_title" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_l">

                    <View
                        android:id="@+id/view_tl_line"
                        android:layout_width="0dp"
                        android:layout_height="3dp"
                        android:layout_marginTop="17dp"
                        android:layout_marginHorizontal="18dp"
                        android:background="@drawable/bg_timeline_gradient"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <LinearLayout
                        android:id="@+id/col_tl_sunrise"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_tl_node_plain"
                            android:contentDescription="@null"
                            android:padding="6dp"
                            android:src="@drawable/ic_sunrise_line"
                            app:tint="@color/golden_600" />

                        <TextView
                            style="@style/Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:text="@string/course_tl_sunrise" />

                        <TextView
                            android:id="@+id/tv_tl_sunrise"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/pretendard_semibold"
                            android:fontFeatureSettings="tnum"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_caption"
                            tools:text="05:48" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/col_tl_golden"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_tl_node"
                            android:contentDescription="@null"
                            android:padding="7dp"
                            android:src="@drawable/ic_golden_hour_line"
                            app:tint="@color/maple_500" />

                        <TextView
                            style="@style/Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:text="@string/course_tl_golden"
                            android:textColor="@color/maple_600" />

                        <TextView
                            android:id="@+id/tv_tl_golden"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/pretendard_semibold"
                            android:fontFeatureSettings="tnum"
                            android:textColor="@color/maple_600"
                            android:textSize="@dimen/text_caption"
                            tools:text="18:40 ~ 19:20" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/col_tl_sunset"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_tl_node_plain"
                            android:contentDescription="@null"
                            android:padding="6dp"
                            android:src="@drawable/ic_sunset_line"
                            app:tint="@color/maple_600" />

                        <TextView
                            style="@style/Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:text="@string/course_tl_sunset" />

                        <TextView
                            android:id="@+id/tv_tl_sunset"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/pretendard_semibold"
                            android:fontFeatureSettings="tnum"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_caption"
                            tools:text="19:32" />
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ─────────── CTA ─────────── -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_make_course"
            style="@style/Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:layout_marginHorizontal="@dimen/screen_padding"
            android:minHeight="54dp"
            android:text="@string/course_make" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save_plan"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:layout_marginHorizontal="@dimen/screen_padding"
            android:fontFamily="@font/mapo_backpacking"
            android:minHeight="52dp"
            android:text="@string/course_save_plan"
            android:textColor="@color/maple_600"
            android:textSize="@dimen/text_button"
            app:cornerRadius="@dimen/radius_button"
            app:strokeColor="@color/maple_300" />

        <TextView
            android:id="@+id/tv_course_error"
            style="@style/Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:gravity="center"
            android:textColor="@color/maple_600"
            android:visibility="gone"
            tools:text="촬영지를 먼저 불러와야 해요"
            tools:visibility="visible" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
