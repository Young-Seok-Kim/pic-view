<?xml version="1.0" encoding="utf-8"?>
<!--
    브랜드 스플래시 화면(SplashActivity). 시안: 정읍 산과 강 위로 해가 뜨는
    그림을 꽉 채우고, 가운데에 앱 이름 · 가는 구분선(가운데 마름모) · 태그라인.

    splash_scene 은 천천히 당겨지고(켄 번즈), 그 위로 단풍잎이 떨어지며,
    글자는 아래에서 떠오릅니다. 움직임은 모두 BrandSplash 가 시작합니다.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/splash_sun">

    <ImageView
        android:id="@+id/splash_scene"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/splash_scene"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!--
        시작 창(OS 가 강제로 띄우는 단색)과 같은 색의 막. 첫 프레임에서
        이 막이 걷히며 그림이 드러나므로, 단색 → 그림이 끊기지 않고 이어집니다.
    -->
    <View
        android:id="@+id/splash_veil"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/splash_sun"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.youngs.picview.ui.splash.SplashLeavesView
        android:id="@+id/splash_leaves"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 글자 묶음. 시안에서 제목이 화면 세로 51% 지점에 옵니다. -->
    <TextView
        android:id="@+id/splash_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:alpha="0"
        android:fontFamily="@font/pretendard"
        android:letterSpacing="0.06"
        android:text="@string/app_name"
        android:textColor="@color/splash_title"
        android:textSize="36sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.485" />

    <LinearLayout
        android:id="@+id/splash_divider"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:alpha="0"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/splash_title">

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:background="@color/splash_divider" />

        <View
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginHorizontal="8dp"
            android:background="@color/splash_title"
            android:rotation="45" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:background="@color/splash_divider" />
    </LinearLayout>

    <TextView
        android:id="@+id/splash_tagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:alpha="0"
        android:fontFamily="@font/pretendard"
        android:textColor="@color/splash_tagline"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/splash_divider"
        tools:text="@string/app_tagline" />
</androidx.constraintlayout.widget.ConstraintLayout>
