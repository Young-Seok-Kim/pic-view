<?xml version="1.0" encoding="utf-8"?>
<!-- MY 탭 "최근 촬영" 한 칸. 사진 위에 장소와 구도 태그가 얹힙니다. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="104dp"
    android:layout_margin="4dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <ImageView
        android:id="@+id/iv_my_photo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/cd_spot_photo"
        android:scaleType="centerCrop"
        tools:src="@drawable/bg_image_placeholder" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_scrim_bottom"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_s"
        android:paddingTop="@dimen/space_l"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/tv_my_photo_place"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="구절초 지방정원" />

        <TextView
            android:id="@+id/tv_my_photo_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:textColor="#CCFFFFFF"
            android:textSize="10sp"
            tools:text="#반영" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
