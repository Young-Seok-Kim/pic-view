<?xml version="1.0" encoding="utf-8"?>
<!--
    최근 촬영 아카이브 한 칸.

    사진 아래 어두운 띠에 "무엇을 연습한 장면"인지 답니다 — 구도와 빛.
    장소 이름은 여기 두지 않습니다. 두 줄이 되면 사진이 안 보이고,
    같은 장소를 여러 번 찍으면 같은 글자만 반복됩니다.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="82dp"
    android:layout_margin="3dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="10dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <ImageView
        android:id="@+id/iv_my_photo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/cd_spot_photo"
        android:scaleType="centerCrop"
        tools:src="@drawable/bg_image_placeholder" />

    <TextView
        android:id="@+id/tv_my_photo_tag"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_scrim_bottom"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingHorizontal="6dp"
        android:paddingTop="@dimen/space_m"
        android:paddingBottom="5dp"
        android:textColor="@color/white"
        android:textSize="10sp"
        android:textStyle="bold"
        tools:text="대칭 · 저녁 사광" />
</com.google.android.material.card.MaterialCardView>
