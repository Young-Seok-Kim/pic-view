<?xml version="1.0" encoding="utf-8"?>
<!-- 하루치 출사 기록 카드. 방문 목록 + 일기(있으면). -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_m"
    app:cardBackgroundColor="@color/bg_card"
    app:cardCornerRadius="@dimen/radius_card"
    app:cardElevation="0dp"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_l">

        <!-- 날짜 + 통계 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_diary_date"
                style="@style/Text.SectionTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                tools:text="8월 4일 (화)" />

            <TextView
                android:id="@+id/tv_diary_stats"
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_score_chip"
                android:paddingHorizontal="@dimen/space_s"
                android:paddingVertical="2dp"
                android:textColor="@color/score_chip_text"
                android:textStyle="bold"
                tools:text="3곳 · 평균 79" />
        </LinearLayout>

        <!-- 방문 목록 -->
        <TextView
            android:id="@+id/tv_diary_visits"
            style="@style/Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:textColor="@color/maple_600"
            tools:text="10:16 정읍사예술회관 · 11:45 씨아전복 · 12:53 정읍문화원" />

        <!--
          오늘의 감정 (시안). 일기 본문과 달리 감정은 고르는 것이라
          글자로는 안 쓰게 됩니다. 누르면 그 날짜에 저장됩니다.
        -->
        <TextView
            style="@style/Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:text="@string/diary_feelings_label"
            android:textColor="@color/text_secondary" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chips_diary_feelings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            app:chipSpacingHorizontal="6dp"
            app:chipSpacingVertical="0dp" />

        <!--
          그날 찍은 사진.
          방문 기록에 붙은 사진만 나옵니다(촬영 화면에서 셔터를 누르면 붙습니다).
          사진이 없는 날에는 줄 자체를 감춥니다.
        -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_diary_photos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:visibility="gone"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_diary_photo"
            tools:visibility="visible" />

        <!-- 일기 본문 -->
        <View
            android:id="@+id/view_diary_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="@dimen/space_m"
            android:background="@color/divider" />

        <TextView
            android:id="@+id/tv_diary_entry_title"
            style="@style/Text.Diary.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="단풍이 물들기 전, 정읍의 하루" />

        <!-- 본문은 편지지 위에 앉힙니다. 앱이 만든 정보가 아니라 '내가 쓴 글'입니다. -->
        <TextView
            android:id="@+id/tv_diary_body"
            style="@style/Text.Diary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:background="@drawable/bg_diary_paper"
            android:lineSpacingExtra="6dp"
            android:padding="@dimen/space_l"
            tools:text="이른 시간의 정읍사예술회관은 사람이 적어서 좋았다. 한낮의 강한 빛을 피해 실내로 옮겼다." />

        <!-- 액션 -->
        <LinearLayout
            android:id="@+id/layout_diary_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_diary_generate"
                style="@style/Button.Primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                tools:text="✨ 일기 만들기" />

            <!--
              생성된 일기를 사용자가 고칠 수 있어야 합니다.
              LLM 이 쓴 문장이 사실과 다르거나 말투가 안 맞을 수 있고,
              무엇보다 "내 일기"라면 내가 고칠 수 있어야 합니다.
            -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_diary_edit"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_s"
                android:minHeight="@dimen/touch_target"
                android:text="@string/diary_edit"
                android:visibility="gone"
                app:cornerRadius="@dimen/radius_button"
                tools:visibility="visible" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_diary_share"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_s"
                android:minHeight="@dimen/touch_target"
                android:text="@string/diary_share"
                app:cornerRadius="@dimen/radius_button" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress_diary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_m"
            android:indeterminateTint="@color/maple_500"
            android:visibility="gone"
            tools:visibility="visible" />

        <!--
          ── 시선이의 다음 추천 (시안) ──
          가장 최근 기록 카드에만 붙습니다. 오늘의 기록이 다음 출사로
          이어지는 자리 — 추천은 결정론 계산(촬영 특성·빛 시각)이고,
          사진은 관광공사 API 대표 사진입니다.
        -->
        <LinearLayout
            android:id="@+id/layout_diary_next"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:background="@drawable/bg_detail_note"
            android:orientation="vertical"
            android:padding="@dimen/space_m"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/diary_next_eyebrow"
                android:textColor="@color/maple_600"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_next_headline"
                style="@style/Text.SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                tools:text="다음에는 물빛을 따라가보세요" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:id="@+id/iv_next_photo"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@color/bg_image_placeholder"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_m"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_next_title"
                            style="@style/Text.Body"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textStyle="bold"
                            tools:text="정읍 시기동 연지" />

                        <TextView
                            android:id="@+id/tv_next_comp"
                            style="@style/Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_s"
                            android:background="@drawable/bg_phase_badge"
                            android:paddingHorizontal="@dimen/space_s"
                            android:paddingVertical="2dp"
                            android:textColor="@color/maple_600"
                            android:textStyle="bold"
                            tools:text="반사 + 여백" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_next_time"
                        style="@style/Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/maple_500"
                        android:textStyle="bold"
                        tools:text="⏱ 추천 시간 내일 06:20" />

                    <TextView
                        android:id="@+id/tv_next_desc"
                        style="@style/Text.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textColor="@color/text_secondary"
                        tools:text="잔잔한 물에 하늘과 나무가 비쳐요." />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_next_prepare"
                style="@style/Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:text="@string/diary_next_prepare"
                app:backgroundTint="@color/maple_500" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
