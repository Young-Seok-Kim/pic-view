<?xml version="1.0" encoding="utf-8"?>
<!-- 하루치 출사 기록 카드. 방문 목록 + 일기(있으면). -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_m"
    app:cardBackgroundColor="@color/bg_card"
    app:cardCornerRadius="@dimen/radius_card"
    app:cardElevation="0dp"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_l">

        <!-- 날짜 + 통계 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_diary_date"
                style="@style/Text.SectionTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                tools:text="8월 4일 (화)" />

            <TextView
                android:id="@+id/tv_diary_stats"
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_score_chip"
                android:paddingHorizontal="@dimen/space_s"
                android:paddingVertical="2dp"
                android:textColor="@color/score_chip_text"
                android:textStyle="bold"
                tools:text="3곳 · 평균 79" />
        </LinearLayout>

        <!-- 방문 목록 -->
        <TextView
            android:id="@+id/tv_diary_visits"
            style="@style/Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:textColor="@color/maple_600"
            tools:text="10:16 정읍사예술회관 · 11:45 씨아전복 · 12:53 정읍문화원" />

        <!-- 일기 본문 -->
        <View
            android:id="@+id/view_diary_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="@dimen/space_m"
            android:background="@color/divider" />

        <TextView
            android:id="@+id/tv_diary_entry_title"
            style="@style/Text.Diary.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="단풍이 물들기 전, 정읍의 하루" />

        <TextView
            android:id="@+id/tv_diary_body"
            style="@style/Text.Diary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:lineSpacingExtra="6dp"
            tools:text="이른 시간의 정읍사예술회관은 사람이 적어서 좋았다. 한낮의 강한 빛을 피해 실내로 옮겼다." />

        <!-- 액션 -->
        <LinearLayout
            android:id="@+id/layout_diary_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_diary_generate"
                style="@style/Button.Primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                tools:text="✨ 일기 만들기" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_diary_share"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_s"
                android:minHeight="@dimen/touch_target"
                android:text="@string/diary_share"
                app:cornerRadius="@dimen/radius_button" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress_diary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_m"
            android:indeterminateTint="@color/maple_500"
            android:visibility="gone"
            tools:visibility="visible" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
