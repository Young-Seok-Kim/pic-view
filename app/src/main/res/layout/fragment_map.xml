<?xml version="1.0" encoding="utf-8"?>
<!--
    촬영지 탐색 지도 — 시안 구조.

    상단 : 제목 바 → 지금 빛 상태줄 → 스토리·촬영 목적 칩.
    지도 : 촬영 목적별 색 마커 + 왼쪽 아래 범례 + 가운데 추천 알약.
    하단 : 마커를 고르면 올라오는 장소 시트(왜 지금 가는지 · 시선 가이드).
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page">

    <FrameLayout
        android:id="@+id/map_view_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- ─────────── 상단 : 제목 · 상태 · 필터 ─────────── -->
    <LinearLayout
        android:id="@+id/layout_map_topbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_m">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/bg_card"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/space_xs"
                android:paddingVertical="@dimen/space_xs">

                <ImageView
                    android:id="@+id/btn_map_back"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cd_back"
                    android:padding="10dp"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/text_primary" />

                <TextView
                    android:id="@+id/tv_map_title"
                    style="@style/Text.Title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_xs"
                    android:layout_weight="1"
                    android:text="@string/map_title" />

                <ImageView
                    android:id="@+id/btn_map_search"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cd_search"
                    android:padding="10dp"
                    android:src="@drawable/ic_search"
                    app:tint="@color/text_primary" />

                <ImageView
                    android:id="@+id/btn_map_layers"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cd_layers"
                    android:padding="10dp"
                    android:src="@drawable/ic_layers"
                    app:tint="@color/text_primary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            app:cardBackgroundColor="@color/bg_card"
            app:cardCornerRadius="14dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp">

            <TextView
                android:id="@+id/tv_map_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/space_l"
                android:paddingVertical="@dimen/space_s"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_caption"
                tools:text="🌅 지금은 석양 · 일몰까지 58분 · 반사 추천" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            app:cardBackgroundColor="@color/bg_card"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/space_m"
                android:paddingVertical="@dimen/space_xs">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Text.Caption"
                        android:layout_width="52dp"
                        android:layout_height="wrap_content"
                        android:text="@string/map_story_label" />

                    <HorizontalScrollView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:scrollbars="none">

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/chips_story"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:chipSpacingHorizontal="6dp"
                            app:singleLine="true"
                            app:singleSelection="true">

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip_story_moon"
                                style="@style/Chip.Tag"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/map_story_moon"
                                app:chipIcon="@drawable/ic_moon"
                                app:chipIconSize="15dp"
                                app:chipIconTint="@color/chip_content_selector"
                                app:chipIconVisible="true" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip_story_love"
                                style="@style/Chip.Tag"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/map_story_love"
                                app:chipIcon="@drawable/ic_heart"
                                app:chipIconSize="15dp"
                                app:chipIconTint="@color/chip_content_selector"
                                app:chipIconVisible="true" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip_story_revolution"
                                style="@style/Chip.Tag"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/map_story_revolution"
                                app:chipIcon="@drawable/ic_flag"
                                app:chipIconSize="15dp"
                                app:chipIconTint="@color/chip_content_selector"
                                app:chipIconVisible="true" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip_story_slow"
                                style="@style/Chip.Tag"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/map_story_slow"
                                app:chipIcon="@drawable/ic_walk"
                                app:chipIconSize="15dp"
                                app:chipIconTint="@color/chip_content_selector"
                                app:chipIconVisible="true" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip_story_season"
                                style="@style/Chip.Tag"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/map_story_season"
                                app:chipIcon="@drawable/ic_leaf"
                                app:chipIconSize="15dp"
                                app:chipIconTint="@color/chip_content_selector"
                                app:chipIconVisible="true" />
                        </com.google.android.material.chip.ChipGroup>
                    </HorizontalScrollView>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Text.Caption"
                        android:layout_width="52dp"
                        android:layout_height="wrap_content"
                        android:text="@string/map_purpose_label" />

                    <HorizontalScrollView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:scrollbars="none">

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/chips_purpose"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:chipSpacingHorizontal="6dp"
                            app:singleLine="true"
                            app:singleSelection="true">

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip_purpose_reflect"
                                style="@style/Chip.Tag"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/map_purpose_reflect"
                                app:chipIcon="@drawable/ic_glyph_drop"
                                app:chipIconSize="15dp"
                                app:chipIconTint="@color/chip_content_selector"
                                app:chipIconVisible="true" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip_purpose_silhouette"
                                style="@style/Chip.Tag"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/map_purpose_silhouette"
                                app:chipIcon="@drawable/ic_glyph_person"
                                app:chipIconSize="15dp"
                                app:chipIconTint="@color/chip_content_selector"
                                app:chipIconVisible="true" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip_purpose_person"
                                style="@style/Chip.Tag"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/map_purpose_person"
                                app:chipIcon="@drawable/ic_people"
                                app:chipIconSize="15dp"
                                app:chipIconTint="@color/chip_content_selector"
                                app:chipIconVisible="true" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip_purpose_arch"
                                style="@style/Chip.Tag"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/map_purpose_arch"
                                app:chipIcon="@drawable/ic_glyph_building"
                                app:chipIconSize="15dp"
                                app:chipIconTint="@color/chip_content_selector"
                                app:chipIconVisible="true" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip_purpose_space"
                                style="@style/Chip.Tag"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/map_purpose_space"
                                app:chipIcon="@drawable/ic_glyph_square"
                                app:chipIconSize="15dp"
                                app:chipIconTint="@color/chip_content_selector"
                                app:chipIconVisible="true" />
                        </com.google.android.material.chip.ChipGroup>
                    </HorizontalScrollView>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- ─────────── 촬영 목적 범례 ─────────── -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_legend"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="@dimen/space_l"
        android:layout_marginBottom="76dp"
        app:cardBackgroundColor="@color/bg_card"
        app:cardCornerRadius="14dp"
        app:cardElevation="4dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_m"
            android:paddingVertical="@dimen/space_s">

            <TextView
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/map_legend_title"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/layout_legend_rows"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:orientation="vertical" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ─────────── 지금 추천 알약 ─────────── -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/pill_map_reco"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="@dimen/space_xl"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="@color/bg_card"
        app:cardCornerRadius="999dp"
        app:cardElevation="4dp"
        app:strokeWidth="0dp">

        <TextView
            android:id="@+id/tv_map_reco"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/space_l"
            android:paddingVertical="@dimen/space_s"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_caption"
            android:textStyle="bold"
            tools:text="🌙 달 따라 걷기 · 지금 추천" />
    </com.google.android.material.card.MaterialCardView>

    <!-- ─────────── 장소 시트 ─────────── -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/sheet_spot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_sheet_top"
        android:elevation="8dp"
        app:behavior_hideable="true"
        app:behavior_peekHeight="0dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_xl"
            android:paddingBottom="@dimen/space_xl">

            <View
                android:layout_width="44dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_m"
                android:background="@drawable/bg_sheet_handle" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Text.Caption"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/map_sheet_eyebrow" />

                <ImageView
                    android:id="@+id/btn_sheet_bookmark"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/map_save_plan"
                    android:padding="7dp"
                    android:src="@drawable/ic_bookmark"
                    app:tint="@color/text_secondary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/layout_sheet_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_sheet_title"
                            style="@style/Text.Display"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textSize="23sp"
                            tools:text="정읍사문화공원" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginStart="2dp"
                            android:contentDescription="@null"
                            android:src="@drawable/baseline_chevron_right_24"
                            app:tint="@color/text_tertiary" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_sheet_reason"
                        style="@style/Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:ellipsize="end"
                        android:maxLines="2"
                        tools:text="수면에 빛이 길게 번지는 시간" />
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="104dp"
                    android:layout_height="76dp"
                    android:layout_marginStart="@dimen/space_m"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:id="@+id/iv_sheet_photo"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/cd_spot_photo"
                        android:scaleType="centerCrop"
                        tools:src="@drawable/bg_image_placeholder" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/space_l"
                android:background="@color/divider" />

            <!-- 현재 빛 · 이동 · 체류 · 난이도 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/map_stat_light" />

                    <TextView
                        android:id="@+id/tv_stat_light"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/pretendard_semibold"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        tools:text="🌅 석양" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:layout_marginVertical="4dp"
                    android:background="@color/divider" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/map_stat_travel" />

                    <TextView
                        android:id="@+id/tv_stat_travel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/pretendard_semibold"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        tools:text="🚘 18분" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:layout_marginVertical="4dp"
                    android:background="@color/divider" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/map_stat_stay" />

                    <TextView
                        android:id="@+id/tv_stat_stay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/pretendard_semibold"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        tools:text="🕐 40분" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:layout_marginVertical="4dp"
                    android:background="@color/divider" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/map_stat_level" />

                    <TextView
                        android:id="@+id/tv_stat_level"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/pretendard_semibold"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        tools:text="🚶 천천히" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/space_m"
                android:background="@color/divider" />

            <!-- 추천 구성 · 사진가를 위한 한 줄 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.9"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/map_reco_comp" />

                    <TextView
                        android:id="@+id/tv_sheet_comp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:fontFamily="@font/pretendard_semibold"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        tools:text="👤 실루엣 + ⬚ 여백" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_m"
                    android:layout_weight="1.1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/map_one_line" />

                    <TextView
                        android:id="@+id/tv_sheet_note"
                        style="@style/Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:textSize="13sp"
                        tools:text="달이 보이는 방향에 빈 공간을 남기고 사람을 작게 두어보세요." />
                </LinearLayout>
            </LinearLayout>

            <!-- CTA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_sheet_guide"
                    style="@style/Button.Primary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="50dp"
                    android:text="@string/map_open_guide"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_sheet_save"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_s"
                    android:layout_weight="1"
                    android:fontFamily="@font/mapo_backpacking"
                    android:minHeight="50dp"
                    android:text="@string/map_save_plan"
                    android:textColor="@color/maple_600"
                    android:textSize="14sp"
                    app:cornerRadius="@dimen/radius_button"
                    app:strokeColor="@color/maple_300" />
            </LinearLayout>

            <!-- 출사 단계 : 발견 → 선택 → 촬영 → 기록 → 재계획 -->
            <LinearLayout
                android:layout_width="match_parent"
