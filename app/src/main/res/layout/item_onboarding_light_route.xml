<?xml version="1.0" encoding="utf-8"?>
<!--
    온보딩 2장 : LIGHT ROUTE (시안 2번 화면).
    정자·산 풍경 실사진을 테두리 없이 가득 깔고 위아래를 배경색으로
    녹입니다. 하루의 빛 타임라인 예시가 사진 위에 떠 있습니다 —
    일출 → 아침 빛 → 골든 아워 → 일몰. 골든 아워 칸만 살려서 강조합니다.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingVertical="@dimen/space_l">

        <TextView
            style="@style/Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.14"
            android:text="@string/onboarding_2_eyebrow"
            android:textColor="@color/maple_600"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            style="@style/Text.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:gravity="center"
            android:paddingHorizontal="@dimen/space_3xl"
            android:text="@string/onboarding_2_title" />

        <TextView
            style="@style/Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:gravity="center"
            android:lineSpacingExtra="6dp"
            android:paddingHorizontal="@dimen/space_3xl"
            android:text="@string/onboarding_2_desc" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="380dp"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/onb_light_route" />

            <View
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_gravity="top"
                android:background="@drawable/bg_onboarding_fade_top" />

            <View
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_gravity="bottom"
                android:background="@drawable/bg_onboarding_fade_bottom" />

            <!-- 하루의 빛 타임라인 예시 — 값은 시안의 예시 그대로입니다. -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginHorizontal="@dimen/space_xl"
                android:layout_marginBottom="@dimen/space_l"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="@dimen/radius_card"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/space_s"
                    android:paddingVertical="@dimen/space_l">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/onboarding_demo_tl_sunrise_time"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold" />

                        <TextView
                            style="@style/Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/onboarding_demo_tl_sunrise"
                            android:textColor="@color/text_tertiary" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/onboarding_demo_tl_morning_time"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold" />

                        <TextView
                            style="@style/Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/onboarding_demo_tl_morning"
                            android:textColor="@color/text_tertiary" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/onboarding_demo_tl_golden_time"
                            android:textColor="@color/maple_500"
                            android:textStyle="bold" />

                        <TextView
                            style="@style/Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/onboarding_demo_tl_golden"
                            android:textColor="@color/maple_500"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/onboarding_demo_tl_sunset_time"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold" />

                        <TextView
                            style="@style/Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/onboarding_demo_tl_sunset"
                            android:textColor="@color/text_tertiary" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </FrameLayout>
    </LinearLayout>
</ScrollView>
